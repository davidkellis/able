#!/usr/bin/env python3
"""Reconcile current bytecode target budgets with completed region-tier gates."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
from typing import Any


SCRIPT_DIR = Path(__file__).resolve().parent
REPO_ROOT = SCRIPT_DIR.parent
DEFAULT_EVIDENCE = SCRIPT_DIR / "bench-bytecode-semantic-region-feasibility.json"
CHECKED_JSON = SCRIPT_DIR / "docs/perf-baselines/2026-07-22-bytecode-semantic-region-tier-feasibility.json"
CHECKED_MARKDOWN = SCRIPT_DIR / "docs/perf-baselines/2026-07-22-bytecode-semantic-region-tier-feasibility.md"


def load_json(path: Path, label: str) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        raise ValueError(f"{label} not found: {path}") from None
    except json.JSONDecodeError as error:
        raise ValueError(f"invalid {label} JSON in {path}: {error}") from None
    if not isinstance(value, dict):
        raise ValueError(f"{label} must be a JSON object")
    return value


def resolve_source(record: Any, label: str) -> Path:
    if not isinstance(record, dict):
        raise ValueError(f"{label} source must be an object")
    raw_path = record.get("path")
    expected = record.get("sha256")
    if not isinstance(raw_path, str) or not raw_path:
        raise ValueError(f"{label} source needs a path")
    if not isinstance(expected, str) or len(expected) != 64:
        raise ValueError(f"{label} source needs a SHA-256 fingerprint")
    path = Path(raw_path)
    if not path.is_absolute():
        path = REPO_ROOT / path
    try:
        actual = hashlib.sha256(path.read_bytes()).hexdigest()
    except FileNotFoundError:
        raise ValueError(f"{label} source not found: {path}") from None
    if actual != expected:
        raise ValueError(
            f"{label} source fingerprint drifted: expected {expected}, got {actual}"
        )
    return path


def source_record(path: Path) -> dict[str, str]:
    return {
        "path": str(path.resolve()),
        "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
    }


def positive_number(value: Any, label: str) -> float:
    if not isinstance(value, (int, float)) or isinstance(value, bool) or value <= 0:
        raise ValueError(f"{label} must be a positive number")
    return float(value)


def frontier_rows(frontier: dict[str, Any]) -> dict[str, dict[str, Any]]:
    if frontier.get("kind") != "able-performance-frontier":
        raise ValueError("frontier has an invalid kind")
    rows = frontier.get("rows")
    if not isinstance(rows, list):
        raise ValueError("frontier needs rows")
    result = {}
    for row in rows:
        if not isinstance(row, dict) or row.get("mode") != "bytecode":
            continue
        benchmark = row.get("benchmark")
        if not isinstance(benchmark, str) or benchmark in result:
            raise ValueError("frontier has an invalid or repeated bytecode row")
        result[benchmark] = row
    return result


def current_region_bounds(
    census: dict[str, Any], rows: dict[str, dict[str, Any]]
) -> list[dict[str, Any]]:
    raw_rows = census.get("rows")
    if not isinstance(raw_rows, list) or not raw_rows:
        raise ValueError("typed region census needs rows")
    seen_families: set[str] = set()
    result = []
    for raw in raw_rows:
        if not isinstance(raw, dict):
            raise ValueError("typed region row must be an object")
        benchmark = raw.get("benchmark")
        family = raw.get("family")
        scope = raw.get("scope")
        if not isinstance(benchmark, str) or not isinstance(family, str):
            raise ValueError("typed region row needs benchmark and family")
        if family in seen_families:
            raise ValueError(f"typed region census repeats family {family}")
        seen_families.add(family)
        share = positive_number(
            raw.get("instruction_share_percent"), f"{benchmark} instruction share"
        )
        if share >= 100:
            raise ValueError(f"{benchmark} instruction share must be below 100")
        row = rows.get(benchmark)
        if row is None or scope != "full":
            result.append({**raw, "current_rankable": False})
            continue
        current = positive_number(row.get("able_real_seconds"), f"{benchmark} time")
        budget = positive_number(row.get("target_budget_seconds"), f"{benchmark} budget")
        required = current / budget
        uniform_cost_gain = 1.0 / (1.0 - share / 100.0)
        remaining = required / uniform_cost_gain
        result.append(
            {
                **raw,
                "current_rankable": True,
                "current_seconds": current,
                "target_budget_seconds": budget,
                "required_speedup": round(required, 6),
                "uniform_instruction_cost_free_region_speedup": round(
                    uniform_cost_gain, 6
                ),
                "remaining_speedup_in_uniform_cost_model": round(
                    remaining, 6
                ),
                "uniform_cost_model_reaches_target": remaining <= 1.0,
            }
        )
    return result


def build_report(evidence_path: Path) -> dict[str, Any]:
    evidence = load_json(evidence_path, "semantic-region evidence")
    if evidence.get("kind") != "able-bytecode-semantic-region-feasibility-evidence":
        raise ValueError("semantic-region evidence has an invalid kind")
    if evidence.get("schema_version") != 1:
        raise ValueError("semantic-region evidence needs schema_version 1")
    minimum_families = evidence.get("minimum_unlike_families")
    if not isinstance(minimum_families, int) or minimum_families < 3:
        raise ValueError("minimum unlike families must be at least three")
    sources = evidence.get("sources")
    if not isinstance(sources, dict):
        raise ValueError("semantic-region evidence needs sources")
    paths = {name: resolve_source(record, name) for name, record in sources.items()}
    frontier = load_json(paths["frontier"], "frontier")
    architecture = load_json(paths["architecture_budget"], "architecture budget")
    semantic = load_json(paths["semantic_work"], "semantic-work report")
    ownership = load_json(paths["ownership_census"], "ownership census")
    if architecture.get("kind") != "able-bytecode-architecture-budget":
        raise ValueError("architecture budget has an invalid kind")
    if semantic.get("kind") != "able-bytecode-semantic-work-amplification":
        raise ValueError("semantic-work report has an invalid kind")
    boundaries = ownership.get("boundaries")
    if not isinstance(boundaries, list):
        raise ValueError("ownership census needs boundaries")
    dispatch = next(
        (row for row in boundaries if row.get("id") == "bytecode-primary-dispatch"),
        None,
    )
    if dispatch is None:
        raise ValueError("ownership census is missing bytecode-primary-dispatch")
    census = evidence.get("typed_region_census")
    if not isinstance(census, dict):
        raise ValueError("semantic-region evidence needs typed_region_census")
    if census.get("exact_sequences_shared") is not False:
        raise ValueError("typed region census must retain exact sequence divergence")
    bounds = current_region_bounds(census, frontier_rows(frontier))
    prototype = census.get("prototype")
    if not isinstance(prototype, dict) or prototype.get("kept") is not False:
        raise ValueError("typed region prototype must retain its rejected result")
    prototype_rows = prototype.get("rows")
    if not isinstance(prototype_rows, list) or len(prototype_rows) < minimum_families:
        raise ValueError("typed region prototype needs three unlike application rows")
    if any(positive_number(row.get("change_percent"), "prototype change") <= 0 for row in prototype_rows):
        raise ValueError("typed region prototype evidence must retain all regressions")
    architecture_summary = architecture.get("summary", {})
    semantic_summary = semantic.get("summary", {})
    rejected = (
        architecture_summary.get("decision") == "no-go-register-representation-only"
        and semantic_summary.get("eligible_mechanism_count") == 0
        and dispatch.get("candidate_admitted") is False
        and dispatch.get("disposition") == "closed-rejected-mechanisms"
    )
    if not rejected:
        raise ValueError("current architecture evidence no longer closes region work")
    rankable = [row for row in bounds if row.get("current_rankable")]
    return {
        "kind": "able-bytecode-semantic-region-feasibility",
        "schema_version": 1,
        "sources": {
            "evidence": source_record(evidence_path),
            **{name: source_record(path) for name, path in paths.items()},
        },
        "summary": {
            "decision": "no-go-current-semantic-region-tier",
            "candidate_eligible": False,
            "minimum_unlike_families": minimum_families,
            "material_region_family_count": len(census["rows"]),
            "rankable_current_region_rows": len(rankable),
            "uniform_cost_model_target_closures": sum(
                row["uniform_cost_model_reaches_target"] for row in rankable
            ),
            "prototype_application_count": len(prototype_rows),
            "prototype_regression_count": sum(
                row["change_percent"] > 0 for row in prototype_rows
            ),
            "current_semantic_candidate_count": semantic_summary.get(
                "eligible_mechanism_count"
            ),
            "minimum_remaining_speedup_after_free_transport": architecture_summary.get(
                "minimum_remaining_speedup_after_transport"
            ),
        },
        "typed_region_bounds": bounds,
        "typed_region_prototype": prototype,
        "closed_tier_routes": [
            {
                "id": "generic-safe-typed-region-executor",
                "result": "rejected-broad-wall-time",
                "reason": "The exact sequences differed, and the shared out-of-line executor regressed all three governing applications."
            },
            {
                "id": "whole-function-register-executor",
                "result": "rejected-broad-wall-time",
                "reason": "Allocation-neutral frames and continuation-probe removal did not make the register engine beat the ordinary VM across guards."
            },
            {
                "id": "go-cross-suite-pgo",
                "result": "rejected-deployability-and-guard",
                "reason": "Runtime extern plugins require the exact training profile, and matched-profile JSON still regressed."
            },
            {
                "id": "current-exact-semantic-operation",
                "result": "rejected-insufficient-shared-materiality",
                "reason": "The six-family semantic-work audit admits zero exact operation or operation family."
            }
        ],
        "next_architecture_lane": evidence.get("next_architecture_lane"),
    }


def markdown(report: dict[str, Any]) -> str:
    summary = report["summary"]
    lines = [
        "# Bytecode semantic-region tier feasibility reconciliation",
        "",
        "## Decision",
        "",
        f"**{summary['decision']}**.",
        "",
        "Do not build another Go-level semantic-region executor, superinstruction",
        "dispatcher, whole-function register loop, or PGO-trained CLI from the current",
        "evidence. These are completed gates, not untried implementations.",
        "",
        "## Current target-budget sizing model",
        "",
        "| Application | Family | Instruction share | Required gain | Uniform-cost free-region gain | Remaining gain | Model reaches target? |",
        "| --- | --- | ---: | ---: | ---: | ---: | --- |",
    ]
    for row in report["typed_region_bounds"]:
        if not row["current_rankable"]:
            continue
        lines.append(
            f"| `{row['benchmark']}` | {row['family']} | "
            f"{row['instruction_share_percent']:.2f}% | {row['required_speedup']:.2f}x | "
            f"{row['uniform_instruction_cost_free_region_speedup']:.2f}x | "
            f"{row['remaining_speedup_in_uniform_cost_model']:.2f}x | "
            f"{'yes' if row['uniform_cost_model_reaches_target'] else 'no'} |"
        )
    lines += [
        "",
        "This is a sizing model, not a mathematical upper bound: the census records",
        "dynamic instruction share rather than sampled wall-time share. It assumes every",
        "instruction has equal average cost and then makes the admitted region free.",
        "Only Monte Carlo Pi crosses its current near-target threshold in that model;",
        "the other rows illustrate how much larger their deficits are than the observed",
        "region coverage. The executable prototype result, not this model, closes another",
        "Go-level region executor.",
        "",
        "The broader current six-family architecture model independently makes all stack",
        "transport free and still leaves at least "
        f"{summary['minimum_remaining_speedup_after_free_transport']:.2f}x required.",
        "",
        "## Completed executable gates",
        "",
        "| Route | Result | Why it is closed |",
        "| --- | --- | --- |",
    ]
    for route in report["closed_tier_routes"]:
        lines.append(
            f"| `{route['id']}` | `{route['result']}` | {route['reason']} |"
        )
    prototype = report["typed_region_prototype"]
    lines += [
        "",
        "The typed-region prototype used one generic safe-opcode executor because the",
        "exact hot sequences differed by application. Its retained repeated means were:",
        "",
        "| Application | Pairs | Baseline | Candidate | Change |",
        "| --- | ---: | ---: | ---: | ---: |",
    ]
    for row in prototype["rows"]:
        lines.append(
            f"| `{row['benchmark']}` | {row['pairs']} | "
            f"{row['baseline_seconds']:.6f}s | {row['candidate_seconds']:.6f}s | "
            f"+{row['change_percent']:.2f}% |"
        )
    lane = report["next_architecture_lane"]
    lines += [
        "",
        "## Reconciliation conclusion",
        "",
        "The prior recommendation used “semantic-region tier” too broadly. A second",
        "Go dispatcher and a whole-function Go executor were already tested and rejected.",
        "The current semantic-work audit also finds zero exact operation family material",
        "in three unlike high-excess applications. No runtime prototype is admitted.",
        "",
        "## Next recommendation",
        "",
        f"Complete **{lane['id']}** as a design-and-budget tranche before writing runtime code.",
        "",
        lane["scope"],
        "",
        f"Why: {lane['why']}",
        "",
        "The design must cover:",
        "",
    ]
    lines.extend(f"- {item}." for item in lane["requirements"])
    lines += [
        "",
        f"Admission gate: {lane['admission']}",
        "",
        "This remains non-WASM work and may not introduce application, benchmark, named",
        "container, or non-primitive nominal special cases.",
        "",
        "## Reproduction",
        "",
        "```sh",
        "python3 v12/bench_bytecode_semantic_region_feasibility_test.py",
        "v12/bench_bytecode_semantic_region_feasibility --check",
        "```",
        "",
    ]
    return "\n".join(lines)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--evidence", type=Path, default=DEFAULT_EVIDENCE)
    parser.add_argument("--json-out", type=Path)
    parser.add_argument("--markdown-out", type=Path)
    parser.add_argument("--check", action="store_true")
    args = parser.parse_args()
    try:
        report = build_report(args.evidence)
    except ValueError as error:
        parser.error(str(error))
    encoded = json.dumps(report, indent=2, sort_keys=True) + "\n"
    rendered = markdown(report)
    if args.json_out:
        args.json_out.write_text(encoded, encoding="utf-8")
    if args.markdown_out:
        args.markdown_out.write_text(rendered, encoding="utf-8")
    if args.check:
        if CHECKED_JSON.read_text(encoding="utf-8") != encoded:
            raise SystemExit("checked semantic-region JSON artifact is stale")
        if CHECKED_MARKDOWN.read_text(encoding="utf-8") != rendered:
            raise SystemExit("checked semantic-region Markdown artifact is stale")
    elif not args.json_out and not args.markdown_out:
        print(encoded, end="")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
