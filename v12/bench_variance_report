#!/usr/bin/env python3
"""Aggregate external scorecard samples into a variance report.

Inputs may be multiple legacy `bench_compare_external` JSON reports, one
report that retains repeated per-run samples, or two complete external
scorecard cohorts. This tool never runs workloads or decides a performance
pass/fail: it reports spread for later selection work.
"""

from __future__ import annotations

import argparse
import json
import math
import statistics
import sys
from pathlib import Path
from typing import Any

from bench_scorecard_cohort import canonical_stdlib_source_state
from bench_scorecard_selection import canonical_record, manifest_keys, manifest_record


REPO_ROOT = Path(__file__).resolve().parent.parent


def display_path(path: Path) -> str:
    try:
        return str(path.resolve().relative_to(REPO_ROOT))
    except ValueError:
        return str(path)


def load(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        raise ValueError(f"input file not found: {path}") from None
    except json.JSONDecodeError as error:
        raise ValueError(f"invalid JSON in {path}: {error}") from None
    if not isinstance(value, dict):
        raise ValueError(f"scorecard root must be an object: {path}")
    if not isinstance(value.get("rows"), list) or not value["rows"]:
        raise ValueError(f"scorecard rows must be a non-empty array: {path}")
    return value


def finite_number(value: Any) -> float | None:
    if not isinstance(value, (int, float)) or not math.isfinite(value):
        return None
    return float(value)


def stats(samples: list[float]) -> dict[str, float | int] | None:
    if not samples:
        return None
    mean = statistics.fmean(samples)
    minimum = min(samples)
    maximum = max(samples)
    result: dict[str, float | int] = {
        "samples": len(samples),
        "mean": mean,
        "median": statistics.median(samples),
        "minimum": minimum,
        "maximum": maximum,
        "range": maximum - minimum,
        "half_spread_pct": ((maximum - minimum) / (2 * mean) * 100) if mean else 0.0,
    }
    if len(samples) > 1:
        stdev = statistics.stdev(samples)
        result["sample_stdev"] = stdev
        result["coefficient_of_variation_pct"] = (stdev / mean * 100) if mean else 0.0
    else:
        result["sample_stdev"] = 0.0
        result["coefficient_of_variation_pct"] = 0.0
    return result


def status(able: dict[str, Any]) -> str:
    if able.get("ok_runs", 0):
        return "verified" if able.get("validation", {}).get("status") == "verified" else "unverified"
    if able.get("timeouts", 0):
        return "timeout"
    if able.get("failures", 0):
        return "failure"
    return "unavailable"


def successful_sample_seconds(raw_samples: Any) -> list[float]:
    if not isinstance(raw_samples, list):
        return []
    samples: list[float] = []
    for raw in raw_samples:
        if not isinstance(raw, dict) or raw.get("status") != "ok":
            continue
        value = finite_number(raw.get("real_seconds"))
        if value is not None:
            samples.append(value)
    return samples


def require_exact_successful_samples(
    raw_samples: Any, path: Path, label: str, required_runs: int
) -> None:
    if not isinstance(raw_samples, list):
        raise ValueError(
            f"{display_path(path)}: {label} has no retained samples; rerun with --runs {required_runs}"
        )
    if len(raw_samples) != required_runs:
        raise ValueError(
            f"{display_path(path)}: {label} has {len(raw_samples)} retained samples, expected {required_runs}"
        )
    run_numbers: set[int] = set()
    for sample in raw_samples:
        if not isinstance(sample, dict):
            raise ValueError(f"{display_path(path)}: {label} contains an invalid retained sample")
        run = sample.get("run")
        if type(run) is not int:
            raise ValueError(f"{display_path(path)}: {label} sample has no integer run number")
        run_numbers.add(run)
        if sample.get("status") != "ok" or finite_number(sample.get("real_seconds")) is None:
            raise ValueError(f"{display_path(path)}: {label} must retain only successful timed samples")
        if not isinstance(sample.get("stdout_sha256"), str) or not sample["stdout_sha256"]:
            raise ValueError(f"{display_path(path)}: {label} sample is missing its verified output hash")
    if run_numbers != set(range(1, required_runs + 1)):
        raise ValueError(
            f"{display_path(path)}: {label} run numbers must be exactly 1 through {required_runs}"
        )


def require_retained_runs(
    payload: dict[str, Any],
    path: Path,
    required_runs: int,
    selected_keys: set[tuple[str, str]] | None = None,
) -> None:
    languages = payload.get("languages")
    if (
        not isinstance(languages, list)
        or not languages
        or any(not isinstance(language, str) or not language for language in languages)
    ):
        raise ValueError(f"{display_path(path)}: retained-run evidence needs a non-empty language list")
    requested_languages = set(languages)
    for raw_row in payload["rows"]:
        if not isinstance(raw_row, dict):
            raise ValueError(f"{display_path(path)}: scorecard row must be an object")
        (benchmark, mode), _ = normalize_row(raw_row, path)
        if selected_keys is not None and (benchmark, mode) not in selected_keys:
            continue
        label = f"{benchmark}/{mode}"
        able = raw_row["able"]
        validation = able.get("validation")
        if not isinstance(validation, dict) or validation.get("status") != "verified":
            raise ValueError(f"{display_path(path)}: {label} Able result is not verifier-backed")
        if able.get("ok_runs") != required_runs or validation.get("verified_runs") != required_runs:
            raise ValueError(
                f"{display_path(path)}: {label} Able result does not verify exactly {required_runs} runs"
            )
        if able.get("timeouts") != 0 or able.get("failures") != 0 or validation.get("failed_runs") != 0:
            raise ValueError(f"{display_path(path)}: {label} Able result includes unsuccessful runs")
        require_exact_successful_samples(able.get("samples"), path, f"{label} Able", required_runs)

        comparisons = raw_row.get("comparisons")
        if not isinstance(comparisons, dict) or not comparisons:
            raise ValueError(f"{display_path(path)}: {label} has no fresh reference comparison")
        expected_languages = {
            language
            for language in requested_languages
            if (
                (mode == "compiled" and language == "go")
                or (mode != "compiled" and language in {"python", "ruby"})
            )
        }
        if not expected_languages:
            raise ValueError(
                f"{display_path(path)}: {label} has no applicable requested reference language"
            )
        if set(comparisons) != expected_languages:
            raise ValueError(
                f"{display_path(path)}: {label} does not retain every requested reference language"
            )
        for language, comparison in sorted(comparisons.items()):
            if not isinstance(language, str) or not language or not isinstance(comparison, dict):
                raise ValueError(f"{display_path(path)}: {label} has an invalid reference comparison")
            reference_source = comparison.get("reference_source")
            if (
                not isinstance(reference_source, dict)
                or reference_source.get("provenance") != "measured"
            ):
                raise ValueError(
                    f"{display_path(path)}: {label} {language} reference is not a fresh measured source"
                )
            if finite_number(comparison.get("ratio")) is None:
                raise ValueError(f"{display_path(path)}: {label} {language} has no usable ratio")
            require_exact_successful_samples(
                comparison.get("reference_samples"), path, f"{label} {language} reference", required_runs
            )


def normalize_row(row: dict[str, Any], path: Path) -> tuple[tuple[str, str], dict[str, Any]]:
    benchmark = row.get("benchmark")
    mode = row.get("mode")
    able = row.get("able")
    if not isinstance(benchmark, str) or not benchmark:
        raise ValueError(f"{display_path(path)}: row benchmark must be a non-empty string")
    if not isinstance(mode, str) or not mode:
        raise ValueError(f"{display_path(path)}: row mode must be a non-empty string")
    if not isinstance(able, dict):
        raise ValueError(f"{display_path(path)}: {benchmark}/{mode} missing able object")
    comparisons = row.get("comparisons")
    if not isinstance(comparisons, dict):
        comparisons = {}
    ratios: dict[str, float | None] = {}
    references: dict[str, list[float]] = {}
    for language, value in comparisons.items():
        if not isinstance(value, dict):
            continue
        ratios[language] = finite_number(value.get("ratio"))
        samples = successful_sample_seconds(value.get("reference_samples"))
        if samples:
            references[language] = samples
        else:
            reference_seconds = finite_number(value.get("reference_real_seconds"))
            if reference_seconds is not None:
                references[language] = [reference_seconds]
    return (benchmark, mode), {
        "status": status(able),
        "able_seconds": finite_number(able.get("avg_real_seconds")),
        "able_samples": successful_sample_seconds(able.get("samples")),
        "ratios": ratios,
        "reference_samples": references,
    }


def normalized_rows(payload: dict[str, Any], path: Path) -> dict[tuple[str, str], dict[str, Any]]:
    rows: dict[tuple[str, str], dict[str, Any]] = {}
    for raw_row in payload["rows"]:
        if not isinstance(raw_row, dict):
            raise ValueError(f"{display_path(path)}: scorecard row must be an object")
        key, row = normalize_row(raw_row, path)
        if key in rows:
            raise ValueError(f"{display_path(path)}: duplicate row {key[0]}/{key[1]}")
        rows[key] = row
    return rows


def source_metadata(
    payload: dict[str, Any], path: Path, comparison_sources: list[Path] | None = None
) -> dict[str, Any]:
    metadata: dict[str, Any] = {
        "path": display_path(path),
        "generated_at": payload.get("generated_at"),
        "suite": payload.get("suite"),
        "cpu_affinity": payload.get("cpu_affinity"),
        "modes": payload.get("modes"),
        "languages": payload.get("languages"),
    }
    if comparison_sources is not None:
        metadata["comparison_source_count"] = len(comparison_sources)
        metadata["comparison_sources"] = [display_path(source) for source in comparison_sources]
    return metadata


def build_report_from_sources(
    source_rows: list[dict[tuple[str, str], dict[str, Any]]],
    sources: list[dict[str, Any]],
    required_runs: int | None = None,
    selection_manifest: dict[str, Any] | None = None,
) -> dict[str, Any]:

    keys = sorted(set().union(*(rows.keys() for rows in source_rows)))
    report_rows: list[dict[str, Any]] = []
    has_repeated_embedded_row = False
    for benchmark, mode in keys:
        samples: list[dict[str, Any]] = []
        ratio_samples: dict[str, list[float]] = {}
        able_samples: list[float] = []
        reference_samples: dict[str, list[float]] = {}
        for rows in source_rows:
            value = rows.get((benchmark, mode))
            if value is None:
                samples.append({"status": "missing", "able_seconds": None, "ratios": {}, "reference_samples": {}})
                continue
            sample = {
                "status": value["status"],
                "able_seconds": value["able_seconds"],
                "ratios": value["ratios"],
                "reference_samples": value["reference_samples"],
            }
            samples.append(sample)
            if value["status"] == "verified":
                if value["able_samples"]:
                    able_samples.extend(value["able_samples"])
                    has_repeated_embedded_row = has_repeated_embedded_row or len(value["able_samples"]) >= 2
                elif value["able_seconds"] is not None:
                    able_samples.append(value["able_seconds"])
                for language, ratio_value in value["ratios"].items():
                    if ratio_value is not None:
                        ratio_samples.setdefault(language, []).append(ratio_value)
                for language, values in value["reference_samples"].items():
                    reference_samples.setdefault(language, []).extend(values)

        report_rows.append(
            {
                "benchmark": benchmark,
                "mode": mode,
                "samples": samples,
                "able_seconds": stats(able_samples),
                "reference_seconds": {
                    language: stats(values) for language, values in sorted(reference_samples.items())
                },
                "ratios": {language: stats(values) for language, values in sorted(ratio_samples.items())},
            }
        )

    if len(source_rows) < 2 and not has_repeated_embedded_row:
        raise ValueError("provide at least two scorecards or one report with two successful embedded run samples")

    report: dict[str, Any] = {
        "kind": "external-application-variance-report",
        "measurement_source": (
            "Verifier-backed external scorecards. Embedded successful per-run samples are used when "
            "available; legacy reports contribute one aggregate sample per input. This report describes "
            "variability only; it is not a timing threshold gate."
        ),
        "sources": sources,
        "rows": report_rows,
    }
    if required_runs is not None:
        report["required_successful_runs"] = required_runs
    if selection_manifest is not None:
        report["selection_manifest"] = canonical_record(selection_manifest)
    return report


def build_report(paths: list[Path], required_runs: int | None = None) -> dict[str, Any]:
    if len({path.resolve() for path in paths}) != len(paths):
        raise ValueError("each --input path must name a distinct independent comparison report")

    source_rows: list[dict[tuple[str, str], dict[str, Any]]] = []
    sources: list[dict[str, Any]] = []
    for path in paths:
        payload = load(path)
        if required_runs is not None:
            require_retained_runs(payload, path, required_runs)
        source_rows.append(normalized_rows(payload, path))
        sources.append(source_metadata(payload, path))
    return build_report_from_sources(source_rows, sources, required_runs)


def scorecard_source_path(scorecard_path: Path, raw_source: dict[str, Any], index: int) -> Path:
    value = raw_source.get("path")
    if not isinstance(value, str) or not value:
        raise ValueError(f"{display_path(scorecard_path)}: source {index} needs a non-empty path")
    source_path = Path(value)
    if not source_path.is_absolute():
        source_path = REPO_ROOT / source_path
    return source_path


def scorecard_cohort(
    path: Path,
    required_runs: int | None = None,
    selection_manifest: dict[str, Any] | None = None,
) -> tuple[
    dict[tuple[str, str], dict[str, Any]],
    dict[str, Any],
    set[Path],
    set[tuple[str, str]],
]:
    scoreboard = load(path)
    if scoreboard.get("kind") != "external-benchmark-scoreboard":
        raise ValueError(f"{display_path(path)}: expected an external-benchmark-scoreboard")
    raw_stdlib_state = scoreboard.get("canonical_stdlib_source_state")
    if raw_stdlib_state is None:
        if required_runs is not None:
            raise ValueError(
                f"{display_path(path)}: strict cohort evidence needs a canonical stdlib source state; "
                "refresh the cohort"
            )
        stdlib_state = None
    else:
        try:
            stdlib_state = canonical_stdlib_source_state(raw_stdlib_state)
        except ValueError as error:
            raise ValueError(f"{display_path(path)}: {error}") from None
    raw_sources = scoreboard.get("sources")
    if not isinstance(raw_sources, list) or not raw_sources:
        raise ValueError(f"{display_path(path)}: scorecard needs a non-empty sources array")

    scoreboard_rows = normalized_rows(scoreboard, path)
    full_status_keys = set(scoreboard_rows)
    selected_keys = manifest_keys(selection_manifest) if selection_manifest is not None else None
    if selection_manifest is not None:
        raw_embedded_selection = scoreboard.get("selection_manifest")
        if raw_embedded_selection is None:
            raise ValueError(
                f"{display_path(path)}: strict selected evidence needs an embedded selection manifest"
            )
        embedded_selection = canonical_record(raw_embedded_selection)
        if embedded_selection != canonical_record(selection_manifest):
            raise ValueError(
                f"{display_path(path)}: embedded selection manifest differs from the reviewed manifest"
            )
    combined_rows: dict[tuple[str, str], dict[str, Any]] = {}
    comparison_sources: list[Path] = []
    source_identities: set[Path] = set()
    for index, raw_source in enumerate(raw_sources, start=1):
        if not isinstance(raw_source, dict):
            raise ValueError(f"{display_path(path)}: source {index} must be an object")
        source_path = scorecard_source_path(path, raw_source, index)
        source_identity = source_path.resolve()
        if source_identity in source_identities:
            raise ValueError(f"{display_path(path)}: duplicate comparison source {display_path(source_path)}")
        source_identities.add(source_identity)
        comparison = load(source_path)
        if required_runs is not None:
            require_retained_runs(comparison, source_path, required_runs, selected_keys)
        for key, row in normalized_rows(comparison, source_path).items():
            if key in combined_rows:
                raise ValueError(
                    f"{display_path(path)}: comparison sources overlap at {key[0]}/{key[1]}"
                )
            combined_rows[key] = row
        comparison_sources.append(source_path)

    if set(scoreboard_rows) != set(combined_rows):
        missing = sorted(set(scoreboard_rows) - set(combined_rows))
        extra = sorted(set(combined_rows) - set(scoreboard_rows))
        details: list[str] = []
        if missing:
            details.append("missing " + ", ".join(f"{benchmark}/{mode}" for benchmark, mode in missing[:3]))
        if extra:
            details.append("extra " + ", ".join(f"{benchmark}/{mode}" for benchmark, mode in extra[:3]))
        raise ValueError(
            f"{display_path(path)}: scoreboard rows do not match its comparison sources ({'; '.join(details)})"
        )
    metadata = source_metadata(scoreboard, path, comparison_sources)
    metadata["full_status_row_count"] = len(full_status_keys)
    if stdlib_state is not None:
        metadata["canonical_stdlib_source_state"] = stdlib_state
    if selection_manifest is not None:
        missing_selected = sorted(manifest_keys(selection_manifest) - set(combined_rows))
        if missing_selected:
            raise ValueError(
                f"{display_path(path)}: full status is missing selected rows: "
                + ", ".join(
                    f"{benchmark}/{mode}" for benchmark, mode in missing_selected[:5]
                )
            )
        combined_rows = {
            key: row for key, row in combined_rows.items() if key in manifest_keys(selection_manifest)
        }
        metadata["selected_row_count"] = len(combined_rows)
        metadata["selection_manifest"] = canonical_record(selection_manifest)
    return combined_rows, metadata, source_identities, full_status_keys


def build_scorecard_report(
    paths: list[Path],
    required_runs: int | None = None,
    selection_manifest: dict[str, Any] | None = None,
) -> dict[str, Any]:
    if len(paths) < 2:
        raise ValueError("provide at least two complete scorecard cohorts for ratio variability")
    if len({path.resolve() for path in paths}) != len(paths):
        raise ValueError("each --scorecard path must name a distinct complete scorecard")

    source_rows: list[dict[tuple[str, str], dict[str, Any]]] = []
    sources: list[dict[str, Any]] = []
    cohort_source_identities: list[set[Path]] = []
    expected_keys: set[tuple[str, str]] | None = None
    expected_full_status_keys: set[tuple[str, str]] | None = None
    expected_stdlib_state: dict[str, Any] | None = None
    for path in paths:
        rows, metadata, source_identities, full_status_keys = scorecard_cohort(
            path, required_runs, selection_manifest
        )
        row_keys = set(rows)
        if expected_keys is None:
            expected_keys = row_keys
        elif row_keys != expected_keys:
            raise ValueError(
                f"{display_path(path)}: complete scorecard coverage differs from the first cohort"
            )
        if expected_full_status_keys is None:
            expected_full_status_keys = full_status_keys
        elif full_status_keys != expected_full_status_keys:
            raise ValueError(
                f"{display_path(path)}: full status coverage differs from the first cohort"
            )
        stdlib_state = metadata.get("canonical_stdlib_source_state")
        if expected_stdlib_state is None:
            expected_stdlib_state = stdlib_state
        elif stdlib_state != expected_stdlib_state:
            raise ValueError(
                f"{display_path(path)}: canonical stdlib source state differs from the first cohort"
            )
        for previous in cohort_source_identities:
            if source_identities & previous:
                raise ValueError(
                    f"{display_path(path)}: complete scorecard reuses comparison sources from another cohort"
                )
        source_rows.append(rows)
        sources.append(metadata)
        cohort_source_identities.append(source_identities)
    return build_report_from_sources(
        source_rows, sources, required_runs, selection_manifest
    )


def fmt_stat(value: dict[str, Any] | None) -> str:
    if not value:
        return "n/a"
    return "median={:.4f}, mean={:.4f}, range={:.4f}, CV={:.2f}%".format(
        value["median"], value["mean"], value["range"], value["coefficient_of_variation_pct"]
    )


def render_markdown(report: dict[str, Any]) -> str:
    lines = [
        "# External Application Variance Report",
        "",
        "This is a report-only sample spread analysis. It does not set or enforce a performance threshold.",
        "When one report embeds repeated runs, timing columns use those runs directly; ratio samples remain report-level because independent Able and reference runs are not paired.",
    ]
    required_runs = report.get("required_successful_runs")
    if required_runs is not None:
        lines.extend(
            [
                f"Every Able and fresh-reference component retained exactly {required_runs} successful verifier-backed runs.",
                "",
            ]
        )
    selection_manifest = report.get("selection_manifest")
    if isinstance(selection_manifest, dict):
        lines.extend(
            [
                "Strict variance uses the explicit reviewed selection manifest: "
                f"{selection_manifest['row_count']} rows, SHA-256 "
                f"`{selection_manifest['selection_sha256']}`. Full status rows, including "
                "timeouts, remain in each input cohort.",
                "",
            ]
        )
    lines.extend(
        [
            "| Benchmark | Mode | Verified samples | Able seconds | Reference seconds | Source-level reference ratios |",
            "| --- | --- | ---: | --- | --- | --- |",
        ]
    )
    for row in report["rows"]:
        verified = row["able_seconds"]["samples"] if row["able_seconds"] else 0
        ratios = "; ".join(
            f"{language}: {fmt_stat(value)}" for language, value in row["ratios"].items()
        ) or "n/a"
        references = "; ".join(
            f"{language}: {fmt_stat(value)}" for language, value in row["reference_seconds"].items()
        ) or "n/a"
        lines.append(
            "| `{}` | `{}` | {} | {} | {} | {} |".format(
                row["benchmark"], row["mode"], verified, fmt_stat(row["able_seconds"]), references, ratios
            )
        )
    lines.extend(["", "## Inputs", ""])
    for source in report["sources"]:
        source_count = source.get("comparison_source_count")
        cohort_note = f", {source_count} comparison source reports" if source_count is not None else ""
        stdlib_state = source.get("canonical_stdlib_source_state")
        if isinstance(stdlib_state, dict):
            cohort_note += ", stdlib {} ({})".format(
                stdlib_state["source_tree_sha256"][:12],
                "dirty" if stdlib_state["git_dirty"] else "clean",
            )
        lines.append(
            "- `{}` — generated `{}`, CPU `{}`{}".format(
                source["path"], source["generated_at"], source["cpu_affinity"], cohort_note
            )
        )
    return "\n".join(lines) + "\n"


def main() -> int:
    parser = argparse.ArgumentParser(description="Aggregate repeated external scorecards into a variance report.")
    input_group = parser.add_mutually_exclusive_group(required=True)
    input_group.add_argument(
        "--input",
        action="append",
        metavar="PATH",
        help="comparison JSON; one input is valid when it retains repeated per-run samples",
    )
    input_group.add_argument(
        "--scorecard",
        action="append",
        metavar="PATH",
        help="complete external scorecard; provide two independent cohorts with identical coverage",
    )
    parser.add_argument(
        "--require-runs",
        type=int,
        metavar="N",
        help="require exactly N retained successful verifier-backed Able and fresh-reference runs per row",
    )
    parser.add_argument(
        "--selection-manifest",
        metavar="PATH",
        help="reviewed mode-aware manifest for strict complete-scorecard variance",
    )
    parser.add_argument("--output-json", required=True, metavar="PATH", help="write report JSON")
    parser.add_argument("--output-md", metavar="PATH", help="optionally write Markdown")
    args = parser.parse_args()

    try:
        if args.require_runs is not None and args.require_runs < 1:
            raise ValueError("--require-runs must be at least one")
        if args.selection_manifest and not args.scorecard:
            raise ValueError("--selection-manifest is valid only with --scorecard")
        if args.scorecard and args.require_runs is not None and not args.selection_manifest:
            raise ValueError(
                "strict complete-scorecard variance requires --selection-manifest"
            )
        selection = (
            manifest_record(Path(args.selection_manifest), REPO_ROOT)
            if args.selection_manifest
            else None
        )
        if args.scorecard:
            report = build_scorecard_report(
                [Path(value) for value in args.scorecard], args.require_runs, selection
            )
        else:
            report = build_report([Path(value) for value in args.input], args.require_runs)
    except ValueError as error:
        print(f"bench_variance_report: {error}", file=sys.stderr)
        return 2

    output_json = Path(args.output_json)
    output_json.parent.mkdir(parents=True, exist_ok=True)
    output_json.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
    if args.output_md:
        output_md = Path(args.output_md)
        output_md.parent.mkdir(parents=True, exist_ok=True)
        output_md.write_text(render_markdown(report), encoding="utf-8")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
