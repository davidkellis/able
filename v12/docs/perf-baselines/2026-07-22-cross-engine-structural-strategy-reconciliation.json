  "semantic_obligations": [
    {
      "id": "values-identity-and-gc",
      "requirement": "Preserve primitive values, boxed values, nominal identity, aliases, mutation, and liveness without retaining movable Go pointers in foreign memory."
    },
    {
      "id": "dispatch-and-nominal-semantics",
      "requirement": "Preserve overload, interface, generic-union, inherent-method, dynamic member, and general non-primitive nominal translation rules without named-type exceptions."
    },
    {
      "id": "errors-and-structured-unwind",
      "requirement": "Preserve source-attached errors, raise/rescue/ensure/rethrow, propagation, cleanup, break/continue, and return coercion."
    },
    {
      "id": "concurrency-and-suspension",
      "requirement": "Preserve spawn, Future, await, cancellation, yielding, serial scheduling, goroutine scheduling, and bounded fairness polls."
    },
    {
      "id": "externs-and-host-interop",
      "requirement": "Preserve extern calls, host values, package/runtime state, and callback reentrancy without depending on an unstable Go ABI."
    },
    {
      "id": "diagnostics-and-exact-resume",
      "requirement": "Retain original instruction and source identity for failures, side exits, fallback, and reproducible diagnostics."
    },
    {
      "id": "portable-fallback-and-distribution",
      "requirement": "Define supported platforms, dependency and license policy, executable-memory policy, compile latency, bounded caches, and exact ordinary-VM fallback."
    }
  ],
