package tapelang_alphabet

import able.fs
import able.io.{read, stdin, stdout, write_all}
import able.kernel.{Array}
import able.os

OP_INC: i32 := 1
OP_MOVE: i32 := 2
OP_INPUT: i32 := 3
OP_PRINT: i32 := 4
OP_LOOP_START: i32 := 5
OP_LOOP_END: i32 := 6

struct Program {
  kinds: Array i32,
  values: Array i32,
  jumps: Array i32
}

struct Tape {
  cells: Array i32,
  pos: i32
}

methods Tape {
  fn new() -> Tape {
    cells: Array i32 := Array.with_capacity(2)
    cells.push(0)
    cells.push(0)
    Tape { cells, pos: 1 }
  }

  fn ensure(self: Self, target: i32) -> void {
    loop {
      if target < self.cells.len() { break }
      self.cells.push(0)
    }
  }

  fn get(self: Self) -> i32 {
    self.cells.read_slot(self.pos)
  }

  fn set(self: Self, value: i32) -> void {
    self.cells.write_slot(self.pos, value)
  }

  fn inc(self: Self, delta: i32) -> void {
    self.cells.write_slot(self.pos, self.cells.read_slot(self.pos) + delta)
  }

  fn move(self: Self, delta: i32) -> void {
    self.pos = self.pos + delta
    self.ensure(self.pos)
  }
}

fn default_program_path() -> String {
  "benchmark.tape"
}

fn emit_op(kinds: Array i32, values: Array i32, jumps: Array i32, kind: i32, value: i32, jump: i32) -> void {
  kinds.push(kind)
  values.push(value)
  jumps.push(jump)
}

fn parse_program(code: Array u8) -> Program {
  kinds: Array i32 := Array.with_capacity(code.len())
  values: Array i32 := Array.with_capacity(code.len())
  jumps: Array i32 := Array.with_capacity(code.len())
  stack: Array i32 := Array.with_capacity(32)

  idx := 0
  loop {
    if idx >= code.len() { break }
    byte := code.read_slot(idx)
    if byte == 43_u8 {
      emit_op(kinds, values, jumps, OP_INC, 1, -1)
    } elsif byte == 45_u8 {
      emit_op(kinds, values, jumps, OP_INC, -1, -1)
    } elsif byte == 62_u8 {
      emit_op(kinds, values, jumps, OP_MOVE, 1, -1)
    } elsif byte == 60_u8 {
      emit_op(kinds, values, jumps, OP_MOVE, -1, -1)
    } elsif byte == 105_u8 {
      emit_op(kinds, values, jumps, OP_INPUT, 0, -1)
    } elsif byte == 111_u8 {
      emit_op(kinds, values, jumps, OP_PRINT, 0, -1)
    } elsif byte == 91_u8 {
      start := kinds.len()
      emit_op(kinds, values, jumps, OP_LOOP_START, 0, -1)
      stack.push(start)
    } elsif byte == 93_u8 {
      stack.pop() match {
        case nil => {},
        case start: i32 => {
          finish := kinds.len()
          emit_op(kinds, values, jumps, OP_LOOP_END, 0, start)
          jumps.write_slot(start, finish)
        }
      }
    }
    idx = idx + 1
  }

  Program { kinds, values, jumps }
}

fn read_input_byte() -> i32 {
  read(stdin(), 1) match {
    case nil => 0,
    case bytes: Array u8 => {
      if bytes.len() == 0 { 0 } else { bytes.read_slot(0) as i32 }
    }
  }
}

fn execute(program: Program) -> Array u8 {
  tape := Tape.new()
  output: Array u8 := Array.with_capacity(32)
  ip := 0
  program_len := program.kinds.len()

  loop {
    if ip >= program_len { break }
    kind := program.kinds.read_slot(ip)
    if kind == OP_INC {
      tape.inc(program.values.read_slot(ip))
      ip = ip + 1
    } elsif kind == OP_MOVE {
      tape.move(program.values.read_slot(ip))
      ip = ip + 1
    } elsif kind == OP_INPUT {
      tape.set(read_input_byte())
      ip = ip + 1
    } elsif kind == OP_PRINT {
      output.push(tape.get() as u8)
      ip = ip + 1
    } elsif kind == OP_LOOP_START {
      if tape.get() == 0 {
        ip = program.jumps.read_slot(ip) + 1
      } else {
        ip = ip + 1
      }
    } else {
      if tape.get() > 0 {
        ip = program.jumps.read_slot(ip)
      } else {
        ip = ip + 1
      }
    }
  }

  output
}

fn run_code(code: Array u8) -> Array u8 {
  execute(parse_program(code))
}

fn main() -> void {
  args := os.args()
  path := if args.len() > 0 { args.get(0)! } else { default_program_path() }
  write_all(stdout(), run_code(fs.read_bytes(path)))
}
