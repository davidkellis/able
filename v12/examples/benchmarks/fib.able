package fib

import able.io
import able.os

fn parse_positive_i32(text: String) -> i32 {
  result := 0
  bytes := io.string_to_bytes(text)
  idx := 0
  loop {
    if idx >= bytes.len() { break }
    byte := bytes.read_slot(idx)
    if byte < 48_u8 || byte > 57_u8 { return 0 }
    result = result * 10 + ((byte - 48_u8) as i32)
    idx = idx + 1
  }
  result
}

fn requested_n() -> i32 {
  args := os.args()
  if args.len() > 0 {
    n := parse_positive_i32(args.get(0)!)
    if n > 0 { return n }
  }
  45
}

fn fib(n: i32) -> i32 {
  if n <= 2 { return 1 }
  fib(n - 1) + fib(n - 2)
}

fn main() {
  print(fib(requested_n()))
}
