package pidigits_benchmark

import able.numbers.bigint_native.{BigIntRef}
import able.io
import able.os

fn parse_positive_i32(text: String) -> i32 {
  result := 0
  bytes := io.string_to_bytes(text)
  idx := 0
  loop {
    if idx >= bytes.len() { break }
    byte := bytes.read_slot(idx)
    if byte < 48_u8 || byte > 57_u8 {
      return result
    }
    result = result * 10 + ((byte - 48_u8) as i32)
    idx = idx + 1
  }
  result
}

fn requested_digits() -> i32 {
  args := os.args()
  if args.len() > 0 {
    count := parse_positive_i32(args.get(0)!)
    if count > 0 { return count }
  }
  10000
}

fn next_term(
  k: i64,
  accum: BigIntRef,
  denom: BigIntRef,
  numer: BigIntRef,
  tmp: BigIntRef
) -> i64 {
  next := k
  loop {
    next = next + 1_i64
    y2 := next * 2_i64 + 1_i64

    tmp.lsh(numer, 1)
    accum.add(accum, tmp)
    accum.mul_i64(accum, y2)
    denom.mul_i64(denom, y2)
    numer.mul_i64(numer, next)

    if accum.compare(numer) > 0 {
      return next
    }
  }
  next
}

fn eliminate_digit(
  digit: i64,
  accum: BigIntRef,
  denom: BigIntRef,
  numer: BigIntRef,
  tmp: BigIntRef,
  ten: BigIntRef
) -> void {
  tmp.set_i64(digit)
  tmp.mul(denom, tmp)
  accum.sub(accum, tmp)
  accum.mul(accum, ten)
  numer.mul(numer, ten)
}

fn print_final_line(line: String, line_count: i32, total: i32) -> void {
  if line_count <= 0 { return }
  padded := line
  count := line_count
  loop {
    if count >= 10 { break }
    padded = `${padded} `
    count = count + 1
  }
  print(`${padded}	:${total}`)
}

fn main() {
  target := requested_digits()

  tmp1 := BigIntRef.zero()
  tmp2 := BigIntRef.zero()
  accum := BigIntRef.zero()
  denom := BigIntRef.one()
  numer := BigIntRef.one()
  three := BigIntRef.new(3_i64)
  ten := BigIntRef.new(10_i64)

  line := ""
  line_count := 0
  produced := 0
  k := 0_i64

  loop {
    if produced >= target { break }

    digit := 0_i64
    loop {
      k = next_term(k, accum, denom, numer, tmp1)
      tmp1.mul(three, numer)
      tmp2.add(tmp1, accum)
      tmp1.div(tmp2, denom)
      d3 := tmp1.to_i64()
      tmp2.add(tmp2, numer)
      tmp1.div(tmp2, denom)
      d4 := tmp1.to_i64()
      if d3 == d4 {
        digit = d3
        break
      }
    }

    produced = produced + 1
    line = `${line}${digit}`
    line_count = line_count + 1
    if line_count == 10 {
      print(`${line}	:${produced}`)
      line = ""
      line_count = 0
    }

    eliminate_digit(digit, accum, denom, numer, tmp1, ten)
  }

  print_final_line(line, line_count, produced)
  three.dispose()
  ten.dispose()
  tmp1.dispose()
  tmp2.dispose()
  accum.dispose()
  denom.dispose()
  numer.dispose()
}
