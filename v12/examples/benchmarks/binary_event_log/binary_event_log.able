package binary_event_log

import able.core.interfaces.{Error}
import able.core.options.*
import able.fs
import able.kernel.{Array, HashMap}
import able.os

DEFAULT_ROUNDS: i32 := 1_024
PROFILE_ROUNDS: i32 := 4_096

struct EventDecodeError { code: i32 }

impl Error for EventDecodeError {
  fn message(self: Self) -> String { "invalid binary event record" }
  fn cause(self: Self) -> ?Error { nil }
}

struct EventRecord {
  timestamp: i64,
  source: i64,
  severity: i64,
  kind: i64,
  payload_hash: i64
}

fn event_error(code: i32) -> Error {
  error: Error = EventDecodeError { code }
  error
}

fn read_u16(bytes: Array u8, offset: i32) -> i64 {
  (bytes.read_slot(offset) as i64) + (bytes.read_slot(offset + 1) as i64) * 256_i64
}

fn read_u32(bytes: Array u8, offset: i32) -> i64 {
  (bytes.read_slot(offset) as i64) +
    (bytes.read_slot(offset + 1) as i64) * 256_i64 +
    (bytes.read_slot(offset + 2) as i64) * 65_536_i64 +
    (bytes.read_slot(offset + 3) as i64) * 16_777_216_i64
}

fn valid_header(bytes: Array u8) -> bool {
  if bytes.len() < 12 { return false }
  bytes.read_slot(0) == 65_u8 &&
    bytes.read_slot(1) == 66_u8 &&
    bytes.read_slot(2) == 76_u8 &&
    bytes.read_slot(3) == 69_u8 &&
    bytes.read_slot(4) == 76_u8 &&
    bytes.read_slot(5) == 79_u8 &&
    bytes.read_slot(6) == 71_u8 &&
    bytes.read_slot(7) == 49_u8
}

fn record_checksum(
  bytes: Array u8,
  payload_start: i32,
  payload_length: i32,
  timestamp: i64,
  source: i64,
  severity: i64,
  kind: i64
) -> i64 {
  value := (timestamp % 65_536_i64) + (timestamp // 65_536_i64)
  value = value + source * 3_i64 + severity * 5_i64 + kind * 7_i64
  index := 0
  loop {
    if index >= payload_length { break }
    value = value + (bytes.read_slot(payload_start + index) as i64) * ((index as i64) + 1_i64)
    index = index + 1
  }
  value % 65_536_i64
}

fn parse_event(
  bytes: Array u8,
  payload_start: i32,
  payload_length: i32,
  timestamp: i64,
  source: i64,
  severity: i64,
  kind: i64,
  checksum: i64
) -> Result EventRecord {
  if severity > 4_i64 { return event_error(1) }
  if kind > 3_i64 { return event_error(2) }
  if record_checksum(bytes, payload_start, payload_length, timestamp, source, severity, kind) != checksum {
    return event_error(3)
  }

  payload_hash := 17_i64
  index := 0
  loop {
    if index >= payload_length { break }
    current := bytes.read_slot(payload_start + index)
    if current < 32_u8 || current > 126_u8 { return event_error(4) }
    payload_hash = (payload_hash * 131_i64 + (current as i64)) % 1_000_003_i64
    index = index + 1
  }
  EventRecord { timestamp, source, severity, kind, payload_hash }
}

fn score_event(record: EventRecord, sequence: i64, salt: i64) -> i64 {
  value := (record.timestamp % 1_000_003_i64) + record.source * 31_i64
  value = value + record.severity * 17_i64 + record.kind * 13_i64 + record.payload_hash
  value = value + sequence * 3_i64 + salt
  step := 0_i64
  loop {
    if step >= 3_i64 { break }
    value = (value * 67_i64 + record.source + record.kind * step + salt) % 1_000_003_i64
    step = step + 1_i64
  }
  value
}

fn map_count(counts: HashMap i64 i64, key: i64) -> i64 {
  counts.raw_get(key) match {
    case nil => 0_i64,
    case value: i64 => value
  }
}

fn rounds_for(args: Array String) -> i32 {
  if args.len() > 1 && args.get(1)! == "--profile" { PROFILE_ROUNDS } else { DEFAULT_ROUNDS }
}

fn main() -> void {
  args := os.args()
  path := if args.len() > 0 { args.get(0)! } else { "events.bin" }
  bytes := fs.read_bytes(path)
  if !valid_header(bytes) {
    print("invalid binary event log")
    return
  }

  record_count := read_u16(bytes, 8) as i32
  rounds := rounds_for(args)
  buckets: Array i64 := Array.with_capacity(4)
  buckets.push(0_i64)
  buckets.push(0_i64)
  buckets.push(0_i64)
  buckets.push(0_i64)
  source_counts: HashMap i64 i64 := HashMap.with_capacity(32)
  accepted := 0_i64
  rejected := 0_i64
  sequence := 0_i64
  total := 0_i64
  checksum := 0_i64
  salt := 29_i64
  scorer := { record, current => score_event(record, current, salt) }

  round := 0
  loop {
    if round >= rounds { break }
    offset := 12
    record_index := 0
    loop {
      if record_index >= record_count { break }
      timestamp := read_u32(bytes, offset)
      source := read_u16(bytes, offset + 4)
      severity := bytes.read_slot(offset + 6) as i64
      kind := bytes.read_slot(offset + 7) as i64
      payload_length := read_u16(bytes, offset + 8) as i32
      payload_start := offset + 10
      payload_end := payload_start + payload_length
      stored_checksum := read_u16(bytes, payload_end)
      offset = payload_end + 2

      resolved := parse_event(bytes, payload_start, payload_length, timestamp, source, severity, kind, stored_checksum)
      if resolved.is_ok() {
        accepted = accepted + 1_i64
        record := resolved.unwrap_or(EventRecord { timestamp: 0_i64, source: 0_i64, severity: 0_i64, kind: 0_i64, payload_hash: 0_i64 })
        value := resolved.map<i64>({ current => scorer(current, sequence) }).unwrap_or(0_i64)
        bucket := record.kind as i32
        buckets.write_slot(bucket, buckets.read_slot(bucket) + 1_i64)
        source_counts.raw_set(record.source, map_count(source_counts, record.source) + 1_i64)
        total = total + value
        checksum = (checksum + value * 7_i64 + record.source * 19_i64 + record.kind * 23_i64 + sequence * 3_i64) % 1_000_003_i64
      } else {
        rejected = rejected + 1_i64
        fallback := 97_i64 + (sequence % 101_i64) + source
        total = total + fallback
        checksum = (checksum + fallback * 11_i64 + kind * 13_i64 + sequence * 5_i64) % 1_000_003_i64
      }
      sequence = sequence + 1_i64
      record_index = record_index + 1
    }
    round = round + 1
  }

  distinct := 0_i64
  source_checksum := 0_i64
  source := 1_i64
  loop {
    if source > 23_i64 { break }
    count := map_count(source_counts, source)
    if count > 0_i64 {
      distinct = distinct + 1_i64
      source_checksum = source_checksum + source * count
    }
    source = source + 1_i64
  }

  print(`${sequence}:${accepted}:${rejected}:${distinct}:${buckets.read_slot(0)},${buckets.read_slot(1)},${buckets.read_slot(2)},${buckets.read_slot(3)}:${source_checksum}:${total}:${checksum}`)
}
