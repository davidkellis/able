package regex_suffix_audit

import able.core.interfaces.{Error}
import able.fs
import able.kernel.{Array}
import able.os
import able.text.regex.{Match, Regex, RegexBuilder, RegexCharRange}

fn suffix_code(value: String) -> i64 {
  if value == "ing" { return 3_i64 }
  if value == "tion" { return 5_i64 }
  7_i64
}

fn build_suffix_regex() -> Regex {
  chars: Array char := Array.new()
  ranges: Array RegexCharRange := Array.new()
  ranges.push(RegexCharRange { start: 'a', end: 'z' })
  stem := RegexBuilder.char_class(chars, ranges, false).one_or_more()
  suffix := RegexBuilder.literal("ing")
    .alternate(RegexBuilder.literal("tion"))
    .alternate(RegexBuilder.literal("ment"))
    .named_capture("suffix") match {
      case builder: RegexBuilder => builder,
      case err: Error => { raise err }
    }
  RegexBuilder.start_anchor()
    .concat(stem)
    .concat(suffix)
    .concat(RegexBuilder.end_anchor())
    .build() match {
      case regex: Regex => regex,
      case err: Error => { raise err }
    }
}

fn audit_word_limit(args: Array String) -> i32 {
  if args.len() > 1 && args.get(1)! == "--profile" { return 128 }
  512
}

fn main() -> void {
  args := os.args()
  path := if args.len() > 0 { args.get(0)! } else { "wordlist.txt" }
  word_limit := audit_word_limit(args)
  audit_rounds := 4
  words := fs.read_lines_prefix(path, word_limit)
  regex := build_suffix_regex()
  matched: i64 = 0_i64
  checksum: i64 = 0_i64
  round := 0
  loop {
    if round >= audit_rounds { break }
    idx := 0
    loop {
      if idx >= words.len() { break }
      word := words.read_slot(idx)
      regex.match(word) match {
        case found: Match => found.groups.read_slot(0).value match {
          case suffix: String => {
            matched = matched + 1_i64
            checksum = checksum + ((word.len_bytes() as i64) * 17_i64) + suffix_code(suffix)
          },
          case _ => {}
        },
        case nil => {}
      }
      idx = idx + 1
    }
    round = round + 1
  }
  print(`${(words.len() as i64) * (audit_rounds as i64)}:${matched}:${checksum}`)
}
