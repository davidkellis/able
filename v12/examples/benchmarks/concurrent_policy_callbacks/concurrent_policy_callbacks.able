package concurrent_policy_callbacks

import able.fs
import able.io
import able.kernel.{Array, Channel}
import able.os

RECORD_LIMIT: i32 := 32
DEFAULT_ROUNDS: i32 := 64
PROFILE_ROUNDS: i32 := 4
PASS_COUNT: i32 := 6
WORKER_COUNT: i32 := 4
CALLBACK_COUNT: i32 := 3
MODULUS: i64 := 1_000_003_i64

struct PolicyRecord {
  zone: String,
  category: String,
  amount: i64,
  risk: i64,
  active: bool
}

struct PolicyTask {
  sequence: i64,
  record: PolicyRecord,
  policy: i32,
  callback: i32,
  gain: i64
}

struct PolicyScore {
  sequence: i64,
  policy: i32,
  callback: i32,
  bucket: i32,
  value: i64,
  exposure: i64
}

methods PolicyScore {
  fn checksum(self: Self) -> i64 {
    (self.value * 7_i64
      + self.exposure * 3_i64
      + self.sequence * 11_i64
      + (self.policy as i64) * 17_i64
      + (self.callback as i64) * 19_i64
      + (self.bucket as i64) * 23_i64) % MODULUS
  }
}

interface DecisionPolicy {
  fn evaluate(
    self: Self,
    record: PolicyRecord,
    task: PolicyTask,
    adjust: (i64, i64, i64, i64) -> i64
  ) -> PolicyScore
}

struct WeightedPolicy {
  multiplier: i64
}

struct MomentumPolicy {
  offset: i64
}

impl DecisionPolicy for WeightedPolicy {
  fn evaluate(
    self: Self,
    record: PolicyRecord,
    task: PolicyTask,
    adjust: (i64, i64, i64, i64) -> i64
  ) -> PolicyScore {
    state := record.amount * self.multiplier
      + (record.zone.len_bytes() as i64) * 13_i64
      + (record.category.len_bytes() as i64) * 17_i64
      + task.gain
    exposure := 0_i64
    pass := 0
    loop {
      if pass >= PASS_COUNT { break }
      raw := (state
        + record.risk * ((pass as i64) + 1_i64)
        + task.gain * 3_i64) % MODULUS
      state = adjust(raw, record.risk, task.sequence + (pass as i64), task.gain)
      exposure = (exposure
        + state
        + record.amount * ((pass as i64) + 1_i64)) % MODULUS
      pass = pass + 1
    }
    PolicyScore {
      sequence: task.sequence,
      policy: task.policy,
      callback: task.callback,
      bucket: ((record.risk as i32)
        + task.policy
        + task.callback
        + ((state % 4_i64) as i32)
        + if record.active { 1 } else { 0 }) % 4,
      value: (state + exposure) % MODULUS,
      exposure
    }
  }
}

impl DecisionPolicy for MomentumPolicy {
  fn evaluate(
    self: Self,
    record: PolicyRecord,
    task: PolicyTask,
    adjust: (i64, i64, i64, i64) -> i64
  ) -> PolicyScore {
    state := record.amount
      + self.offset
      + (record.zone.len_bytes() as i64) * 29_i64
      + (record.category.len_bytes() as i64) * 31_i64
    exposure := 0_i64
    pass := 0
    loop {
      if pass >= PASS_COUNT { break }
      raw := (state * (67_i64 + (pass as i64))
        + record.risk * task.gain
        + task.sequence) % MODULUS
      state = adjust(raw, record.risk + (pass as i64), task.sequence, task.gain)
      exposure = (exposure
        + state * ((pass as i64) + 2_i64)
        + record.amount) % MODULUS
      pass = pass + 1
    }
    PolicyScore {
      sequence: task.sequence,
      policy: task.policy,
      callback: task.callback,
      bucket: ((record.risk as i32)
        + task.policy
        + task.callback
        + ((state % 4_i64) as i32)
        + if record.active { 2 } else { 0 }) % 4,
      value: (state + exposure) % MODULUS,
      exposure
    }
  }
}

fn parse_i64(text: String) -> i64 {
  bytes := io.string_to_bytes(text)
  negative := false
  index := 0
  if bytes.len() > 0 && bytes.read_slot(0) == 45_u8 {
    negative = true
    index = 1
  }
  value := 0_i64
  loop {
    if index >= bytes.len() { break }
    value = value * 10_i64 + ((bytes.read_slot(index) - 48_u8) as i64)
    index = index + 1
  }
  if negative { -value } else { value }
}

fn parse_record(line: String) -> PolicyRecord {
  fields := line.split("|")
  [zone: String, category: String, amount: String, risk: String, active: String] := fields
  PolicyRecord {
    zone,
    category,
    amount: parse_i64(amount),
    risk: parse_i64(risk),
    active: active == "1"
  }
}

fn load_records(path: String) -> Array PolicyRecord {
  lines := fs.read_lines_prefix(path, RECORD_LIMIT)
  records: Array PolicyRecord := Array.with_capacity(lines.len())
  index := 0
  loop {
    if index >= lines.len() { break }
    records.push(parse_record(lines.read_slot(index)))
    index = index + 1
  }
  records
}

fn make_adjusters(salt: i64) -> Array ((i64, i64, i64, i64) -> i64) {
  adjusters: Array ((i64, i64, i64, i64) -> i64) := Array.with_capacity(CALLBACK_COUNT)
  factor := 5_i64 + (salt % 7_i64)
  bias := 23_i64 + (salt % 13_i64)
  twist := 11_i64 + (salt % 5_i64)
  adjusters.push({ value, risk, sequence, gain =>
    (value * factor + risk * 17_i64 + gain + sequence) % MODULUS
  })
  adjusters.push({ value, risk, sequence, gain =>
    (value + risk * risk + sequence * bias + gain * 3_i64) % MODULUS
  })
  adjusters.push({ value, risk, sequence, gain =>
    (value * twist + risk * (gain + 5_i64) + (sequence % 997_i64)) % MODULUS
  })
  adjusters
}

fn evaluate_task(
  task: PolicyTask,
  adjusters: Array ((i64, i64, i64, i64) -> i64)
) -> PolicyScore {
  adjust := adjusters.read_slot(task.callback)
  if task.policy == 0 {
    selected: DecisionPolicy = WeightedPolicy {
      multiplier: 3_i64 + (task.sequence % 5_i64)
    }
    selected.evaluate(task.record, task, adjust)
  } else {
    selected: DecisionPolicy = MomentumPolicy {
      offset: 41_i64 + (task.sequence % 17_i64)
    }
    selected.evaluate(task.record, task, adjust)
  }
}

fn work(jobs: Channel PolicyTask, results: Channel PolicyScore) -> i64 {
  processed := 0_i64
  adjusters := make_adjusters(17_i64)
  loop {
    jobs.receive() match {
      case nil => {
        results.send(PolicyScore {
          sequence: -1_i64,
          policy: -1,
          callback: -1,
          bucket: -1,
          value: processed,
          exposure: 0_i64
        })
        break
      },
      case task: PolicyTask => {
        results.send(evaluate_task(task, adjusters))
        processed = processed + 1_i64
      }
    }
  }
  processed
}

fn benchmark_rounds(args: Array String) -> i32 {
  if args.len() > 1 && args.get(1)! == "--profile" {
    PROFILE_ROUNDS
  } else {
    DEFAULT_ROUNDS
  }
}

fn main() -> void {
  args := os.args()
  path := if args.len() > 0 { args.get(0)! } else { "policies.txt" }
  records := load_records(path)
  rounds := benchmark_rounds(args)
  task_count := records.len() * rounds
  jobs: Channel PolicyTask = Channel.new(task_count)
  results: Channel PolicyScore = Channel.new(task_count + WORKER_COUNT)
  first := spawn { work(jobs, results) }
  second := spawn { work(jobs, results) }
  third := spawn { work(jobs, results) }
  fourth := spawn { work(jobs, results) }

  sequence := 0_i64
  round := 0
  loop {
    if round >= rounds { break }
    index := 0
    loop {
      if index >= records.len() { break }
      jobs.send(PolicyTask {
        sequence,
        record: records.read_slot(index),
        policy: (index + round) % 2,
        callback: (index * 2 + round) % CALLBACK_COUNT,
        gain: ((round % 11) as i64) + 3_i64
      })
      sequence = sequence + 1_i64
      index = index + 1
    }
    round = round + 1
  }
  jobs.close()
  future_flush()

  buckets: Array i64 := Array.with_capacity(4)
  buckets.push(0_i64)
  buckets.push(0_i64)
  buckets.push(0_i64)
  buckets.push(0_i64)
  callbacks: Array i64 := Array.with_capacity(CALLBACK_COUNT)
  callbacks.push(0_i64)
  callbacks.push(0_i64)
  callbacks.push(0_i64)
  finished := 0
  worker_total := 0_i64
  weighted_total := 0_i64
  momentum_total := 0_i64
  total := 0_i64
  exposure_total := 0_i64
  checksum := 0_i64
  loop {
    if finished >= WORKER_COUNT { break }
    score := results.receive()!
    if score.sequence < 0_i64 {
      worker_total = worker_total + score.value
      finished = finished + 1
    } else {
      if score.policy == 0 {
        weighted_total = weighted_total + 1_i64
      } else {
        momentum_total = momentum_total + 1_i64
      }
      callbacks.write_slot(score.callback, callbacks.read_slot(score.callback) + 1_i64)
      buckets.write_slot(score.bucket, buckets.read_slot(score.bucket) + 1_i64)
      total = total + score.value
      exposure_total = exposure_total + score.exposure
      checksum = (checksum + score.checksum()) % MODULUS
    }
  }

  future_total := (first.value()! as i64)
    + (second.value()! as i64)
    + (third.value()! as i64)
    + (fourth.value()! as i64)
  print(`${task_count}:${worker_total}:${future_total}:${weighted_total}:${momentum_total}:${callbacks.read_slot(0)},${callbacks.read_slot(1)},${callbacks.read_slot(2)}:${buckets.read_slot(0)},${buckets.read_slot(1)},${buckets.read_slot(2)},${buckets.read_slot(3)}:${total}:${exposure_total}:${checksum}`)
}
