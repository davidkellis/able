package base64_benchmark

import able.collections.array
import able.core.interfaces.{Error}
import able.crypto.md5
import able.encoding.base64
import able.io
import able.kernel.{Array}

fn repeat_byte(byte: u8, count: i32) -> Array u8 {
  bytes: Array u8 := Array.with_capacity(count)
  i := 0
  loop {
    if i >= count { break }
    bytes.push(byte)
    i = i + 1
  }
  bytes
}

fn decode_or_raise(value: String) -> String {
  base64.decode_string(value) match {
    case decoded: String => decoded,
    case err: Error => { raise err }
  }
}

fn main() {
  str := io.bytes_to_string(repeat_byte(97_u8, 1000000))
  print(md5.hex_string(str))

  i := 0
  loop {
    if i >= 20 { break }
    str = base64.encode_string(str)
    i = i + 1
  }
  print(md5.hex_string(str))

  i = 0
  loop {
    if i >= 20 { break }
    str = decode_or_raise(str)
    i = i + 1
  }
  print(md5.hex_string(str))
}
