package concurrent_event_routing

import able.collections.hash_map.*
import able.collections.map.*
import able.core.interfaces.{Error}
import able.core.options.*
import able.fs
import able.kernel.{Array, Channel}
import able.os

RECORD_LIMIT: i32 := 32
DEFAULT_ROUNDS: i32 := 128
WORKER_COUNT: i32 := 4

struct RoutingError { code: i32 }

impl Error for RoutingError {
  fn message(self: Self) -> String { "invalid routing record" }
  fn cause(self: Self) -> ?Error { nil }
}

struct EventRecord {
  source: String,
  severity: String,
  region: String,
  owner: String,
  payload: String
}

struct EventTask {
  sequence: i64,
  line: String
}

struct AcceptedRoute {
  bucket: i32,
  value: i64
}

struct RejectedRoute {
  code: i32,
  value: i64
}

union RouteState = AcceptedRoute | RejectedRoute

struct RoutedEvent {
  sequence: i64,
  state: RouteState
}

methods RoutedEvent {
  fn accepted(self: Self) -> bool {
    self.state match {
      case AcceptedRoute { bucket: _, value: _ } => true,
      case RejectedRoute { code: _, value: _ } => false
    }
  }

  fn bucket(self: Self) -> i32 {
    self.state match {
      case AcceptedRoute { bucket, value: _ } => bucket,
      case RejectedRoute { code: _, value: _ } => -1
    }
  }

  fn value(self: Self) -> i64 {
    self.state match {
      case AcceptedRoute { bucket: _, value } => value,
      case RejectedRoute { code: _, value } => value
    }
  }

  fn checksum(self: Self) -> i64 {
    self.state match {
      case AcceptedRoute { bucket, value } => value * 7_i64 + (bucket as i64) * 19_i64 + self.sequence * 3_i64,
      case RejectedRoute { code, value } => value * 11_i64 + (code as i64) * 23_i64 + self.sequence * 5_i64
    }
  }
}

fn routing_error(code: i32) -> Error {
  error: Error = RoutingError { code }
  error
}

fn parse_record(line: String) -> Result EventRecord {
  fields := line.split("|")
  if fields.len() != 5 { return routing_error(1) }
  [source: String, severity: String, region: String, owner: String, payload: String] := fields
  if source.len_bytes() == 0 { return routing_error(2) }
  if severity != "INFO" && severity != "WARN" && severity != "ERROR" && severity != "DEBUG" {
    return routing_error(3)
  }
  if region != "us-east" && region != "eu-west" && region != "ap-south" {
    return routing_error(4)
  }
  if owner.len_bytes() == 0 || payload.len_bytes() < 5 { return routing_error(5) }
  EventRecord { source, severity, region, owner, payload }
}

fn route_bucket(severity: String) -> i32 {
  if severity == "ERROR" { 0 }
  elsif severity == "WARN" { 1 }
  elsif severity == "INFO" { 2 }
  else { 3 }
}

fn score_record(record: EventRecord, sequence: i64, salt: i64) -> AcceptedRoute {
  EventRecord {
    source::source_name,
    severity,
    region::region_name,
    owner,
    payload
  } := record
  bucket := route_bucket(severity)
  state := (source_name.len_bytes() as i64) * 31_i64
  state = state + (region_name.len_bytes() as i64) * 17_i64
  state = state + (owner.len_bytes() as i64) * 13_i64
  state = state + (payload.len_bytes() as i64) * 7_i64 + sequence * 3_i64 + salt
  step := 0_i64
  loop {
    if step >= 5_i64 { break }
    if payload.contains("cache") && (step % 2_i64) == 0_i64 {
      state = (state * 131_i64 + sequence + step) % 1_000_003_i64
    } elsif region_name == "eu-west" {
      state = (state * 73_i64 + (bucket as i64) + step) % 1_000_003_i64
    } else {
      state = (state * 67_i64 + salt + step) % 1_000_003_i64
    }
    step = step + 1_i64
  }
  AcceptedRoute { bucket, value: state }
}

fn route_task(task: EventTask, scorer: (EventRecord, i64) -> AcceptedRoute) -> RoutedEvent {
  resolved := parse_record(task.line).map<AcceptedRoute>({ record => scorer(record, task.sequence) })
  if resolved.is_ok() {
    RoutedEvent { sequence: task.sequence, state: resolved.unwrap_or(AcceptedRoute { bucket: 0, value: 0_i64 }) }
  } else {
    fallback := 97_i64 + (task.sequence % 101_i64)
    RoutedEvent { sequence: task.sequence, state: RejectedRoute { code: 1, value: fallback } }
  }
}

fn work(jobs: Channel EventTask, results: Channel RoutedEvent) -> i64 {
  processed := 0_i64
  salt := 17_i64
  scorer := { record, sequence => score_record(record, sequence, salt) }
  loop {
    jobs.receive() match {
      case nil => {
        results.send(RoutedEvent { sequence: -1_i64, state: RejectedRoute { code: -1, value: processed } })
        break
      },
      case task: EventTask => {
        results.send(route_task(task, scorer))
        processed = processed + 1_i64
      }
    }
  }
  processed
}

fn lookup(counts: Map i32 i64, bucket: i32) -> i64 {
  counts.get(bucket) match {
    case value: i64 => value,
    case nil => 0_i64
  }
}

fn routing_rounds(args: Array String) -> i32 {
  if args.len() > 1 && args.get(1)! == "--profile" { 1 } else { DEFAULT_ROUNDS }
}

fn main() -> void {
  args := os.args()
  path := if args.len() > 0 { args.get(0)! } else { "events.txt" }
  lines := fs.read_lines_prefix(path, RECORD_LIMIT)
  rounds := routing_rounds(args)
  task_count := lines.len() * rounds
  jobs: Channel EventTask = Channel.new(task_count)
  results: Channel RoutedEvent = Channel.new(task_count + WORKER_COUNT)
  first := spawn { work(jobs, results) }
  second := spawn { work(jobs, results) }
  third := spawn { work(jobs, results) }
  fourth := spawn { work(jobs, results) }

  sequence := 0_i64
  round := 0
  loop {
    if round >= rounds { break }
    index := 0
    loop {
      if index >= lines.len() { break }
      jobs.send(EventTask { sequence, line: lines.get(index)! })
      sequence = sequence + 1_i64
      index = index + 1
    }
    round = round + 1
  }
  jobs.close()
  future_flush()

  counts: HashMap i32 i64 = HashMap.with_capacity(4)
  finished := 0
  worker_total := 0_i64
  accepted := 0_i64
  rejected := 0_i64
  total := 0_i64
  checksum := 0_i64
  loop {
    if finished >= WORKER_COUNT { break }
    result := results.receive()!
    if result.sequence < 0_i64 {
      worker_total = worker_total + result.value()
      finished = finished + 1
    } else {
      if result.accepted() {
        accepted = accepted + 1_i64
        bucket := result.bucket()
        counts.set(bucket, lookup(counts, bucket) + 1_i64)
      } else {
        rejected = rejected + 1_i64
      }
      total = total + result.value()
      checksum = (checksum + result.checksum()) % 1_000_003_i64
    }
  }

  print(`${task_count}:${worker_total}:${accepted}:${rejected}:${lookup(counts, 0)},${lookup(counts, 1)},${lookup(counts, 2)},${lookup(counts, 3)}:${total}:${checksum}`)
}
