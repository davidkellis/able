package option_result_config

import able.core.interfaces.{Error}
import able.core.options.*

## Resolve deployment capacity from a service-local value, then a regional
## fallback. Missing values and invalid capacities are ordinary configuration
## conditions, so the audit recovers a deterministic safe capacity instead of
## stopping the fleet-wide pass.

SERVICE_COUNT: i32 := 1_024
AUDIT_ROUNDS: i32 := 24

struct ConfigError { code: i32 }

impl Error for ConfigError {
  fn message(self: Self) -> String { "invalid deployment capacity" }
  fn cause(self: Self) -> ?Error { nil }
}

fn config_error(code: i32) -> Error {
  error: Error = ConfigError { code }
  error
}

fn service_override(service: i32) -> Option i32 {
  if (service % 11) == 0 {
    nil
  } else {
    (service * 17 + 9) % 101
  }
}

fn regional_override(service: i32) -> Option i32 {
  if (service % 13) == 0 {
    nil
  } else {
    20 + ((service * 7 + 3) % 61)
  }
}

fn validate_capacity(capacity: i32) -> Result i32 {
  if capacity < 24 {
    config_error(1_i32)
  } elsif capacity > 96 {
    config_error(2_i32)
  } else {
    capacity
  }
}

fn configured_capacity(service: i32) -> Result i32 {
  service_override(service)
    .or_else({ => regional_override(service) })
    .map<i32>({ capacity => (capacity as i32) + (service % 5) })
    .ok_or_else({ => config_error(3_i32) })
    .and_then<i32>({ capacity => validate_capacity(capacity) })
}

fn fallback_capacity(service: i32) -> i32 {
  32 + (service % 17)
}

fn audit_configurations() -> i64 {
  accepted := 0
  recovered := 0
  checksum: i64 = 0_i64
  service := 0
  loop {
    if service >= SERVICE_COUNT { break }
    resolved := configured_capacity(service)
    capacity := resolved.unwrap_or_else({ => fallback_capacity(service) })
    if resolved.is_ok() {
      accepted = accepted + 1
    } else {
      recovered = recovered + 1
    }
    checksum = checksum + (capacity as i64) * ((service % 19) as i64 + 1_i64)
    service = service + 1
  }
  checksum + (accepted as i64) * 1_000_000_i64 + (recovered as i64) * 10_000_i64
}

fn main() -> void {
  round := 0
  total: i64 = 0_i64
  loop {
    if round >= AUDIT_ROUNDS { break }
    total = total + audit_configurations()
    round = round + 1
  }
  print(`${SERVICE_COUNT}:${total}`)
}
