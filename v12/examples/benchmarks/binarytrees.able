package binarytrees

import able.kernel.{Array}
import able.io
import able.os

struct Node {
  left: ?Node,
  right: ?Node
}

struct DepthResult {
  iterations: i32,
  depth: i32,
  check: i32
}

fn parse_positive_i32(text: String) -> i32 {
  result := 0
  bytes := io.string_to_bytes(text)
  idx := 0
  loop {
    if idx >= bytes.len() { break }
    byte := bytes.read_slot(idx)
    if byte < 48_u8 || byte > 57_u8 { return 0 }
    result = result * 10 + ((byte - 48_u8) as i32)
    idx = idx + 1
  }
  result
}

fn requested_depth() -> i32 {
  args := os.args()
  if args.len() > 0 {
    depth := parse_positive_i32(args.get(0)!)
    if depth > 0 { return depth }
  }
  21
}

fn make_tree(depth: i32) -> Node {
  if depth <= 0 {
    return Node { left: nil, right: nil }
  }
  Node {
    left: make_tree(depth - 1),
    right: make_tree(depth - 1)
  }
}

fn check_tree(node: Node) -> i32 {
  node.left match {
    case nil => 1,
    case left: Node => {
      right_check := node.right match {
        case nil => 0,
        case right: Node => check_tree(right)
      }
      1 + check_tree(left) + right_check
    }
  }
}

fn main() {
  n := requested_depth()
  min_depth := 4
  max_depth := n
  if min_depth + 2 > n { max_depth = min_depth + 2 }
  stretch_depth := max_depth + 1

  check := check_tree(make_tree(stretch_depth))
  print(`stretch tree of depth ${stretch_depth}\t check: ${check}`)

  long_lived_tree := make_tree(max_depth)

  handles := Array.new()

  depth := min_depth
  loop {
    if depth > max_depth { break }
    worker_depth := depth
    handles.push(spawn {
      iterations := 1 .<< (max_depth - worker_depth + min_depth)
      batch_check := 0
      i := 1
      loop {
        if i > iterations { break }
        batch_check = batch_check + check_tree(make_tree(worker_depth))
        i = i + 1
      }
      DepthResult {
        iterations: iterations,
        depth: worker_depth,
        check: batch_check
      }
    })
    depth = depth + 2
  }

  future_flush()

  i := 0
  count := handles.length
  loop {
    if i >= count { break }
    result := handles[i].value()! as DepthResult
    print(`${result.iterations}\t trees of depth ${result.depth}\t check: ${result.check}`)
    i = i + 1
  }

  print(`long lived tree of depth ${max_depth}\t check: ${check_tree(long_lived_tree)}`)
}
