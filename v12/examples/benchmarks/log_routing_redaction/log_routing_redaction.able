package log_routing_redaction

import able.core.interfaces.{Error}
import able.fs
import able.kernel.{Array}
import able.os
import able.text.regex.{Regex, RegexSet, ReplacementLiteral}

fn routing_patterns() -> Array String {
  patterns: Array String := Array.with_capacity(5)
  patterns.push("^ERROR .*service=auth .*$")
  patterns.push("^ERROR .*service=payment .*$")
  patterns.push("^WARN .*$")
  patterns.push("^INFO .*$")
  patterns.push("^DEBUG .*$")
  patterns
}

fn compile_regex(pattern: String) -> Regex {
  Regex.compile(pattern) match {
    case regex: Regex => regex,
    case err: Error => { raise err }
  }
}

fn replace_all(regex: Regex, text: String, replacement: String) -> String {
  regex.replace(text, ReplacementLiteral { value: replacement }) match {
    case value: String => value,
    case err: Error => { raise err }
  }
}

fn audit_rounds(args: Array String) -> i32 {
  if args.len() > 1 && args.get(1)! == "--profile" { return 1 }
  4
}

fn byte_size(text: String) -> i64 {
  text.len_bytes() as i64
}

fn main() -> void {
  args := os.args()
  path := if args.len() > 0 { args.get(0)! } else { "logs.txt" }
  lines := fs.read_lines_prefix(path, 20)
  rounds := audit_rounds(args)
  routes := RegexSet.compile(routing_patterns()) match {
    case set: RegexSet => set,
    case err: Error => { raise err }
  }
  email := compile_regex("[a-z]+@[a-z]+[.][a-z]+")
  address := compile_regex("[0-9]+[.][0-9]+[.][0-9]+[.][0-9]+")
  token := compile_regex("token=[A-Z0-9]+")

  counts: Array i64 := Array.with_capacity(5)
  counts.push(0_i64)
  counts.push(0_i64)
  counts.push(0_i64)
  counts.push(0_i64)
  counts.push(0_i64)
  checksum: i64 = 0_i64
  round := 0
  loop {
    if round >= rounds { break }
    idx := 0
    loop {
      if idx >= lines.len() { break }
      line := lines.read_slot(idx)
      matches := routes.matches(line)
      if matches.len() != 1 { raise "log route must be unique" }
      route := matches.read_slot(0) as i32
      counts.write_slot(route, counts.read_slot(route) + 1_i64)

      email_redacted := replace_all(email, line, "[EMAIL]")
      address_redacted := replace_all(address, email_redacted, "[IP]")
      redacted := replace_all(token, address_redacted, "token=[TOKEN]")
      checksum = checksum + (byte_size(redacted) * 31_i64)
      checksum = checksum + (((route as i64) + 1_i64) * 17_i64)
      checksum = checksum + (((idx as i64) + 1_i64) * 3_i64)
      idx = idx + 1
    }
    round = round + 1
  }

  print(`${(lines.len() as i64) * (rounds as i64)}:${counts.read_slot(0)},${counts.read_slot(1)},${counts.read_slot(2)},${counts.read_slot(3)},${counts.read_slot(4)}:${checksum}`)
}
