package channel_rollup

import able.collections.array
import able.collections.enumerable
import able.fs
import able.kernel.{Array, Channel}
import able.os

fn selected(word: String) -> bool {
  size := word.len_bytes()
  size >= 6 && size <= 10 && word.contains("e") && (word.contains("r") || word.contains("t"))
}

fn score(word: String) -> i64 {
  size := word.len_bytes() as i64
  bonus := if word.contains("a") { 13_i64 } elsif word.contains("i") { 7_i64 } else { 3_i64 }
  (size * 11_i64) + bonus
}

fn main() -> void {
  args := os.args()
  path := if args.len() > 0 { args.get(0)! } else { "wordlist.txt" }
  words: Array String = fs.read_lines_prefix(path, 16384)
  source: Channel String = Channel.new(16384)
  scores: Channel i64 = Channel.new(16384)

  spawn {
    index := 0
    loop {
      if index >= words.len() { break }
      source.send(words.get(index)!)
      index = index + 1
    }
    source.close()
    0_i64
  }

  spawn {
    loop {
      source.receive() match {
        case nil => { break },
        case word: String => {
          if selected(word) { scores.send(score(word)) }
        }
      }
    }
    scores.close()
    0_i64
  }

  future_flush()
  selected_count := 0
  total: i64 = 0_i64
  loop {
    scores.receive() match {
      case nil => { break },
      case value: i64 => {
        selected_count = selected_count + 1
        total = total + value
      }
    }
  }
  print(`${words.len()}:${selected_count}:${total}`)
}
