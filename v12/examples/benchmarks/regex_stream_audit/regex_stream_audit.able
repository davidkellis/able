package regex_stream_audit

import able.core.interfaces.{Error}
import able.fs
import able.kernel.{Array}
import able.os
import able.text.regex.{Match, Regex, RegexOptions, RegexScanner}

fn suffix_code(value: String) -> i64 {
  if value == "ing" { return 3_i64 }
  if value == "tion" { return 5_i64 }
  7_i64
}

fn audit_word_limit(args: Array String) -> i32 {
  if args.len() > 1 && args.get(1)! == "--profile" { return 128 }
  512
}

fn main() -> void {
  args := os.args()
  path := if args.len() > 0 { args.get(0)! } else { "wordlist.txt" }
  words := fs.read_lines_prefix(path, audit_word_limit(args))
  options := RegexOptions.default()
  options.multiline = true
  Regex.compile_with_options("^[a-z]+(?P<suffix>ing|tion|ment)$", options) match {
    case regex: Regex => {
      rounds := 4
      matched: i64 = 0_i64
      checksum: i64 = 0_i64
      round := 0
      loop {
        if round >= rounds { break }
        scanner := regex.scan("")
        idx := 0
        loop {
          if idx >= words.len() { break }
          scanner.feed(words.read_slot(idx))
          scanner.feed("\n")
          loop {
            scanner.next() match {
              case found: Match => found.groups.read_slot(0).value match {
                case suffix: String => {
                  matched = matched + 1_i64
                  checksum = checksum + ((found.matched.len_bytes() as i64) * 23_i64) + suffix_code(suffix)
                },
                case _ => {}
              },
              case _ => { break }
            }
          }
          idx = idx + 1
        }
        scanner.flush()
        loop {
          scanner.next() match {
            case found: Match => found.groups.read_slot(0).value match {
              case suffix: String => {
                matched = matched + 1_i64
                checksum = checksum + ((found.matched.len_bytes() as i64) * 23_i64) + suffix_code(suffix)
              },
              case _ => {}
            },
            case _ => { break }
          }
        }
        round = round + 1
      }
      print(`${(words.len() as i64) * (rounds as i64)}:${matched}:${checksum}`)
    },
    case err: Error => { raise err }
  }
}
