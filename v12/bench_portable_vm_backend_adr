#!/usr/bin/env python3
"""Generate and check the portable VM backend ABI/dependency ADR."""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
from typing import Any


SCRIPT_DIR = Path(__file__).resolve().parent
REPO_ROOT = SCRIPT_DIR.parent
DEFAULT_EVIDENCE = SCRIPT_DIR / "bench-portable-vm-backend-adr.json"
CHECKED_JSON = (
    SCRIPT_DIR
    / "docs/perf-baselines/2026-07-22-portable-vm-backend-abi-dependency-adr.json"
)
CHECKED_MARKDOWN = SCRIPT_DIR / "design/portable-vm-backend-abi.md"


def load_json(path: Path, label: str) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        raise ValueError(f"{label} not found: {path}") from None
    except json.JSONDecodeError as error:
        raise ValueError(f"invalid {label} JSON in {path}: {error}") from None
    if not isinstance(value, dict):
        raise ValueError(f"{label} must be a JSON object")
    return value


def resolve_source(record: Any, label: str) -> Path:
    if not isinstance(record, dict):
        raise ValueError(f"{label} source must be an object")
    raw_path = record.get("path")
    expected = record.get("sha256")
    if not isinstance(raw_path, str) or not raw_path:
        raise ValueError(f"{label} source needs a path")
    if not isinstance(expected, str) or len(expected) != 64:
        raise ValueError(f"{label} source needs a SHA-256 fingerprint")
    path = Path(raw_path)
    if not path.is_absolute():
        path = REPO_ROOT / path
    try:
        actual = hashlib.sha256(path.read_bytes()).hexdigest()
    except FileNotFoundError:
        raise ValueError(f"{label} source not found: {path}") from None
    if actual != expected:
        raise ValueError(
            f"{label} source fingerprint drifted: expected {expected}, got {actual}"
        )
    return path


def source_record(path: Path) -> dict[str, str]:
    return {
        "path": str(path.resolve()),
        "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
    }


def validate_evidence(evidence: dict[str, Any]) -> None:
    if evidence.get("kind") != "able-portable-vm-backend-adr-evidence":
        raise ValueError("portable-backend evidence has an invalid kind")
    if evidence.get("schema_version") != 1:
        raise ValueError("portable-backend evidence needs schema_version 1")
    gates = evidence.get("decision_gates")
    if not isinstance(gates, list) or len(gates) < 8:
        raise ValueError("portable-backend evidence needs complete decision gates")
    classes = evidence.get("backend_classes")
    if not isinstance(classes, list) or len(classes) != 3:
        raise ValueError("portable-backend evidence needs exactly three backend classes")
    ids = {row.get("id") for row in classes if isinstance(row, dict)}
    if ids != {
        "whole-engine-c-abi",
        "portable-jit-library",
        "direct-machine-code-generation",
    }:
        raise ValueError("portable-backend evidence has incomplete backend classes")


def variant_passes(variant: dict[str, Any]) -> bool:
    return all(
        (
            variant.get("avoids_per_opcode_callbacks") is True,
            variant.get("one_semantics_owner") is True,
            variant.get("preserves_identity_without_graph_conversion") is True,
            variant.get("portable_fallback") is True,
            variant.get("concrete_toolchain_and_distribution") is True,
            variant.get("prior_rejection_equivalent") is False,
        )
    )


def backend_class_rows(classes: list[dict[str, Any]]) -> list[dict[str, Any]]:
    result = []
    for backend in classes:
        variants = backend.get("variants")
        if not isinstance(variants, list) or len(variants) != 2:
            raise ValueError(f"{backend.get('id')} needs two ownership variants")
        checked_variants = []
        for variant in variants:
            if not isinstance(variant, dict):
                raise ValueError("backend variant must be an object")
            checked_variants.append({**variant, "passes_all_gates": variant_passes(variant)})
        admitted = [row["id"] for row in checked_variants if row["passes_all_gates"]]
        result.append(
            {
                "id": backend.get("id"),
                "implementation_cost": backend.get("implementation_cost"),
                "security_cost": backend.get("security_cost"),
                "disposition": backend.get("disposition"),
                "admitted_variants": admitted,
                "variants": checked_variants,
            }
        )
    return result


def build_report(evidence_path: Path) -> dict[str, Any]:
    evidence = load_json(evidence_path, "portable-backend evidence")
    validate_evidence(evidence)
    sources = evidence.get("sources")
    if not isinstance(sources, dict):
        raise ValueError("portable-backend evidence needs sources")
    paths = {label: resolve_source(record, label) for label, record in sources.items()}
    structural = load_json(paths["structural_strategy"], "structural strategy")
    native = load_json(paths["native_tier_budget"], "native tier budget")
    if structural.get("kind") != "able-cross-engine-structural-strategy-reconciliation":
        raise ValueError("structural strategy has an invalid kind")
    if native.get("kind") != "able-bytecode-native-hot-tier-design-budget":
        raise ValueError("native tier budget has an invalid kind")
    predecessor = structural.get("summary")
    if not isinstance(predecessor, dict):
        raise ValueError("structural strategy needs a summary")
    portable = structural.get("routes", {}).get("portable_lower_level_vm_backend")
    if not isinstance(portable, dict):
        raise ValueError("structural strategy needs the portable backend route")
    reach = native.get("hot_function_reach_budget")
    if not isinstance(reach, list) or not reach:
        raise ValueError("native tier budget needs hot-function reach")
    reach_rows = []
    for row in reach:
        hottest = row.get("hottest_program")
        if not isinstance(hottest, dict):
            raise ValueError("hot-function row needs hottest_program")
        reach_rows.append(
            {
                "benchmark": row.get("benchmark"),
                "family": row.get("family"),
                "hottest_program": hottest.get("name"),
                "program_instruction_share_percent": row.get(
                    "hottest_program_instruction_share_percent"
                ),
                "primitive_instruction_share_percent": row.get(
                    "primitive_eligible_instruction_share_percent"
                ),
                "maximum_static_primitive_span": hottest.get(
                    "max_static_primitive_span"
                ),
                "primitive_instructions": hottest.get(
                    "primitive_eligible_instructions"
                ),
                "effect_boundary_instructions": hottest.get(
                    "effect_boundary_instructions"
                ),
                "contract_eligible": row.get("contract_eligible") is True,
            }
        )
    classes = backend_class_rows(evidence["backend_classes"])
    admitted = [
        (backend["id"], variant)
        for backend in classes
        for variant in backend["admitted_variants"]
    ]
    if admitted:
        decision = "backend-prototype-admitted"
    else:
        decision = "close-portable-foreign-backend-under-current-runtime-contract"
    return {
        "kind": "able-portable-vm-backend-abi-dependency-adr",
        "schema_version": 1,
        "sources": {"evidence": source_record(evidence_path)}
        | {label: source_record(path) for label, path in paths.items()},
        "summary": {
            "decision": decision,
            "prototype_admitted": bool(admitted),
            "selected_backend_count": len(admitted),
            "backend_class_count": len(classes),
            "ownership_variant_count": sum(len(row["variants"]) for row in classes),
            "phase_one_performance_capable": portable.get(
                "passes_phase_one_performance_gate"
            ),
            "phase_one_material_rows": portable.get("phase_one_material_row_count"),
            "phase_one_governing_rows": portable.get(
                "phase_one_governing_row_count"
            ),
            "hot_function_row_count": len(reach_rows),
            "contract_eligible_hot_function_count": sum(
                row["contract_eligible"] for row in reach_rows
            ),
            "maximum_static_primitive_span": max(
                int(row["maximum_static_primitive_span"]) for row in reach_rows
            ),
            "predecessor_decision": predecessor.get("decision"),
        },
        "decision_gates": evidence["decision_gates"],
        "current_abi_observations": evidence.get("current_abi_observations"),
        "hot_function_boundary_evidence": reach_rows,
        "backend_classes": classes,
        "prototype_policy": evidence.get("prototype_policy"),
        "next_lane": evidence.get("next_lane"),
    }


def yn(value: bool) -> str:
    return "yes" if value else "no"


def markdown(report: dict[str, Any]) -> str:
    summary = report["summary"]
    lines = [
        "# Portable VM backend ABI and dependency decision",
        "",
        "Date: 2026-07-22",
        "",
        "Status: accepted architecture closure",
        "",
        "## Decision",
        "",
        f"**`{summary['decision']}`**.",
        "",
        "Do not build a C-ABI engine, adopt a JIT dependency, or add direct machine-code",
        "emitters against the current Go-owned bytecode/runtime object graph. No backend",
        "variant satisfies the semantic, ownership, fallback, deployment, and prior-",
        "rejection gates together, so no executable prototype or dependency is admitted.",
        "",
        "This does not say native execution is too small. The predecessor model shows",
        f"compiled-equivalent reach clears the materiality gate in {summary['phase_one_material_rows']}",
        f"of {summary['phase_one_governing_rows']} phase-one families. It says the current",
        "Go object graph is not a portable execution ABI, and selecting a code generator",
        "does not solve that semantic boundary.",
        "",
        "## Context",
        "",
    ]
    for observation in report["current_abi_observations"]:
        lines.append(f"- **{observation['id']}**: {observation['detail']}")
    lines += [
        "",
        "Go/C handles are suitable opaque roots, not a foreign value model. Foreign code",
        "cannot retain or traverse the interface-, slice-, map-, function-, context-, and",
        "pointer-bearing graphs represented by `runtime.Value`, `bytecodeProgram`, frames,",
        "environments, or futures. Keeping those values Go-owned therefore requires an",
        "exit or callback for the semantic operations that dominate real programs.",
        "",
        "## Measured boundary density",
        "",
        "| Application | Hot program share | Primitive share | Longest primitive span | Effect instructions in hot program | Contract eligible |",
        "| --- | ---: | ---: | ---: | ---: | --- |",
    ]
    for row in report["hot_function_boundary_evidence"]:
        lines.append(
            f"| `{row['benchmark']}` | {row['program_instruction_share_percent']:.2f}% | "
            f"{row['primitive_instruction_share_percent']:.2f}% | "
            f"{row['maximum_static_primitive_span']} | "
            f"{row['effect_boundary_instructions']} | {yn(row['contract_eligible'])} |"
        )
    lines += [
        "",
        f"No hot function is eligible, and the longest static primitive span is only {summary['maximum_static_primitive_span']}",
        "instructions. A safe Go-owned-root design would repeatedly cross the foreign",
        "boundary for calls, collections, allocation, lookup, nominal operations, errors,",
        "unwind, suspension, and externs. That is the completed native-leaf rejection,",
        "not a whole-engine execution design.",
        "",
        "## Alternatives",
        "",
        "| Class / ownership | No per-op callback | One semantic owner | Identity without graph conversion | Exact fallback | Concrete distribution | Prior rejection? | Decision |",
        "| --- | --- | --- | --- | --- | --- | --- | --- |",
    ]
    for backend in report["backend_classes"]:
        for variant in backend["variants"]:
            lines.append(
                f"| `{backend['id']}` / `{variant['id']}` | "
                f"{yn(variant['avoids_per_opcode_callbacks'])} | "
                f"{yn(variant['one_semantics_owner'])} | "
                f"{yn(variant['preserves_identity_without_graph_conversion'])} | "
                f"{yn(variant['portable_fallback'])} | "
                f"{yn(variant['concrete_toolchain_and_distribution'])} | "
                f"{yn(variant['prior_rejection_equivalent'])} | reject |"
            )
    lines += [
        "",
        "### Whole-engine C ABI",
        "",
        "With Go-owned values, C receives opaque handles and must return to Go for real",
        "semantics; this repeats the dense side-exit architecture. With a C-owned heap, it",
        "can remain native but must independently implement values, GC, environments,",
        "dispatch, errors, cleanup, scheduling, futures, and externs. That creates two",
        "semantic authorities and cannot fall back mid-activation without graph conversion.",
        "",
        "### Portable JIT library",
        "",
        "A JIT changes instruction selection and register allocation, not value ownership.",
        "It therefore inherits the same safe-leaf limit with Go-owned values or the same",
        "duplicate-runtime problem with a foreign heap, while adding dependency, license,",
        "compile-latency, executable-memory, cache, and supported-platform decisions.",
        "",
        "### Direct machine-code generation",
        "",
        "Direct emitters inherit the same runtime fork. They additionally require per-OS/",
        "architecture calling conventions, unwind behavior, instruction-cache handling,",
        "W^X memory, code lifetime, and security maintenance. Removing a library does not",
        "remove these obligations.",
        "",
        "## Consequences",
        "",
        "- Ordinary Go bytecode remains the only VM and exact fallback.",
        "- No C/C++/Rust/JIT dependency, foreign heap, executable-memory path, or platform",
        "  support promise is added.",
        "- No `runtime.Value`, Go ABI, AST pointer, or current bytecode layout becomes a",
        "  serialized/public ABI.",
        "- Existing tree-walker/bytecode parity, source diagnostics, concurrency behavior,",
        "  extern behavior, and established performance guards remain unchanged.",
        "- Reopening one of these backend classes requires a backend-neutral semantic ABI",
        "  that invalidates this decision; a different code generator alone does not.",
        "",
        "## Next recommendation",
        "",
    ]
    lane = report["next_lane"]
    lines += [
        f"Complete **`{lane['id']}`**.",
        "",
        lane["scope"],
        "",
        "Required outputs:",
        "",
    ]
    lines.extend(f"- {item}" for item in lane["required_outputs"])
    lines += [
        "",
        "Why: the performance model says whole effectful functions are large enough, but",
        "the current Go representation prevents any foreign backend from owning them",
        "safely and cheaply. The next question is therefore whether Able can have one",
        "implementation-independent semantic ABI—not which machine-code library to call.",
        "",
        f"Admission: {lane['admission']}",
        "",
        f"Exclusions: {lane['exclusions']}",
        "",
        "## Reproduction",
        "",
        "```sh",
        "python3 v12/bench_portable_vm_backend_adr_test.py",
        "v12/bench_portable_vm_backend_adr --check",
        "just bench-evidence-ledger --check",
        "```",
        "",
    ]
    return "\n".join(lines)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--evidence", type=Path, default=DEFAULT_EVIDENCE)
    parser.add_argument("--json-out", type=Path)
    parser.add_argument("--markdown-out", type=Path)
    parser.add_argument("--check", action="store_true")
    args = parser.parse_args()
    try:
        report = build_report(args.evidence)
    except ValueError as error:
        parser.error(str(error))
    rendered_json = json.dumps(report, indent=2, sort_keys=True) + "\n"
    rendered_markdown = markdown(report)
    if args.json_out:
        args.json_out.write_text(rendered_json, encoding="utf-8")
    if args.markdown_out:
        args.markdown_out.write_text(rendered_markdown, encoding="utf-8")
    if args.check:
        if report["summary"]["prototype_admitted"]:
            raise SystemExit("portable backend prototype requires review")
        if args.evidence == DEFAULT_EVIDENCE:
            if CHECKED_JSON.read_text(encoding="utf-8") != rendered_json:
                raise SystemExit("checked portable-backend JSON artifact is stale")
            if CHECKED_MARKDOWN.read_text(encoding="utf-8") != rendered_markdown:
                raise SystemExit("checked portable-backend ADR is stale")
    if not args.json_out and not args.markdown_out and not args.check:
        print(rendered_json, end="")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
