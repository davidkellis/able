package bench_byte_histogram_small

import able.core.interfaces.{Error}
import able.core.iteration.{IteratorEnd}
import able.kernel.{Array}
import able.text.string.{String, StringBuilder}

fn finish_builder(builder: StringBuilder) -> String {
  builder.finish() match {
    case value: String => value,
    case err: Error => { raise err }
  }
}

fn build_text(count: i32) -> String {
  builder := StringBuilder.with_capacity(count * 20)
  i := 0
  loop {
    if i >= count { break }
    builder.push_string(`token${(i * 17) % 251}`)
    builder.push_char(':')
    builder.push_string(`value${(i * 29) % 113}`)
    builder.push_char('|')
    i = i + 1
  }
  finish_builder(builder)
}

fn histogram_score(text: String) -> i64 {
  counts: Array i32 = Array.with_capacity(256)
  idx := 0
  loop {
    if idx >= 256 { break }
    counts.push(0)
    idx = idx + 1
  }

  iter := text.bytes()
  loop {
    iter.next() match {
      case _: IteratorEnd => { break },
      case byte: u8 => {
        slot := byte as i32
        counts[slot] = counts[slot]! + 1
      }
    }
  }

  total: i64 = text.len_bytes() as i64
  idx = 0
  loop {
    if idx >= 256 { break }
    total = total + ((idx as i64) * (counts[idx]! as i64))
    idx = idx + 1
  }
  total
}

fn main() -> void {
  text := build_text(2_048)
  rounds := 0
  total: i64 = 0_i64
  loop {
    if rounds >= 3 { break }
    total = total + histogram_score(text)
    rounds = rounds + 1
  }
  print(total)
}
