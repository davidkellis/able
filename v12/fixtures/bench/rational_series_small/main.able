package bench_rational_series_small

import able.numbers.rational.{Rational}

fn main() -> void {
  total := 0.0
  half := Rational.new(1, 2)
  i := 1
  loop {
    if i > 4_000 { break }
    left := Rational.new((((i * 5) % 23) + 1) as i64, (((i * 7) % 29) + 1) as i64)
    right := Rational.new((((i * 11) % 31) + 1) as i64, (((i * 13) % 37) + 1) as i64)
    total = total + left.add(right).mul(left).div(half).to_f64()
    i = i + 1
  }
  print(total)
}
