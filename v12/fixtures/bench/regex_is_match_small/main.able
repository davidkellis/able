package bench_regex_is_match_small

import able.core.interfaces.{Error}
import able.kernel.{Array}
import able.os
import able.text.regex.{Regex}
import able.text.string.{String, StringBuilder}

fn input_count() -> i32 {
  args := os.args()
  if args.len() > 0 && args.get(0)! == "--profile" { return 128 }
  10_000
}

fn build_inputs(count: i32) -> Array String {
  values: Array String = Array.with_capacity(count)
  i := 0
  loop {
    if i >= count { break }
    builder := StringBuilder.with_capacity(24)
    if i % 3 == 0 {
      builder.push_string("zzaczz")
    } else {
      builder.push_string("zz")
      builder.push_char('a')
      bcount := (i % 5) + 1
      j := 0
      loop {
        if j >= bcount { break }
        builder.push_char('b')
        j = j + 1
      }
      builder.push_char('c')
      builder.push_string("zz")
    }
    builder.finish() match {
      case text: String => values.push(text),
      case err: Error => { raise err }
    }
    i = i + 1
  }
  values
}

fn score(regex: Regex, inputs: Array String) -> i64 {
  total: i64 = 0_i64
  idx := 0
  loop {
    if idx >= inputs.len() { break }
    if regex.is_match(inputs[idx]!) {
      total = total + (idx as i64)
    }
    idx = idx + 1
  }
  total
}

fn main() -> void {
  regex := Regex.compile("ab+c") match {
    case compiled: Regex => compiled,
    case err: Error => { raise err }
  }
  inputs := build_inputs(input_count())
  rounds := 0
  total: i64 = 0_i64
  loop {
    if rounds >= 6 { break }
    total = total + score(regex, inputs)
    rounds = rounds + 1
  }
  print(total)
}
