package bench_await_batch_i64_small

fn checksum(seed: i32) -> i64 {
  value: i64 = seed as i64
  step := 0
  loop {
    if step >= 64 { break }
    value = ((value * 48271_i64) + ((step as i64) * 17_i64) + 3_i64) % 1_000_003_i64
    step = step + 1
  }
  value
}

fn await_pair(seed: i32) -> i64 {
  left = spawn { checksum(seed) }
  right = spawn { checksum(seed + 1) }
  joined = spawn {
    left_value = await [left]
    right_value = await [right]
    (left_value as i64) + (right_value as i64)
  }
  future_flush()
  joined.value()! as i64
}

fn main() -> void {
  total: i64 = 0_i64
  round := 0
  loop {
    if round >= 32 { break }
    total = total + await_pair(round * 2)
    round = round + 1
  }
  print(total)
}
