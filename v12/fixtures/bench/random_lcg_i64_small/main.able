package bench_random_lcg_i64_small

import able.random.{Random}

fn main() -> void {
  rng := Random.seeded(123_456_789_i64)
  i := 0
  total: i64 = 0_i64
  floats := 0.0
  loop {
    if i >= 1_000_000 { break }
    total = total + (rng.next_i64() % 1_000_003_i64)
    floats = floats + rng.next_f64()
    i = i + 1
  }
  print(total)
  print(floats)
}
