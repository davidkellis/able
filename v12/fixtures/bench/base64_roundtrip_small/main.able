package bench_base64_roundtrip_small

import able.core.interfaces.{Error}
import able.crypto.md5
import able.encoding.base64
import able.kernel.{Array}

fn repeat_byte(byte: u8, count: i32) -> Array u8 {
  bytes: Array u8 := Array.with_capacity(count)
  i := 0
  loop {
    if i >= count { break }
    bytes.push(byte)
    i = i + 1
  }
  bytes
}

fn decode_or_raise(value: Array u8) -> Array u8 {
  base64.decode_bytes(value) match {
    case decoded: Array u8 => decoded,
      case err: Error => { raise err }
  }
}

fn main() {
  bytes := repeat_byte(97_u8, 200_000)
  print(md5.hex(bytes))

  i := 0
  loop {
    if i >= 8 { break }
    bytes = base64.encode_bytes(bytes)
    i = i + 1
  }
  print(md5.hex(bytes))

  i = 0
  loop {
    if i >= 8 { break }
    bytes = decode_or_raise(bytes)
    i = i + 1
  }
  print(md5.hex(bytes))
}
