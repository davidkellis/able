package factory_a

import exec_13_10_static_interface_distinct_dictionary_capture.iface_defs.{Item, Renderable}

private impl Renderable for Item {
  fn duplicate(self: Self) -> Self { Item { label: self.label } }
  fn render(self: Self) -> String { `A:${self.label}` }
}

fn make_a(label: String) -> Renderable {
  Item { label }
}
