package exec_06_03_fixed_integer_alternative_arithmetic

fn signed_i8() -> void {
  max := 127_i8
  one := 1_i8
  two := 2_i8
  min := max.wrapping_add(one)
  print(`i8 ${max.wrapping_add(one)} ${min.wrapping_sub(one)} ${max.wrapping_mul(two)} | ${max.saturating_add(one)} ${min.saturating_sub(one)} ${max.saturating_mul(two)} | ${max.checked_add(one)} ${min.checked_sub(one)} ${max.checked_mul(two)} | ${one.checked_add(one)} ${two.checked_sub(one)} ${two.checked_mul(two)}`)
}

fn signed_i16() -> void {
  max := 32767_i16
  one := 1_i16
  two := 2_i16
