}

fn main() -> void {
  signed_i8()
  signed_i16()
  signed_i32()
  signed_i64()
  signed_i128()
  unsigned_u8()
  unsigned_u16()
  unsigned_u32()
  unsigned_u64()
  unsigned_u128()
}
