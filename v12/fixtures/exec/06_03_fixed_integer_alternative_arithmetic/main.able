fn unsigned_u8() -> void {
  max := 255_u8
  zero := 0_u8
  one := 1_u8
  two := 2_u8
  print(`u8 ${max.wrapping_add(one)} ${zero.wrapping_sub(one)} ${max.wrapping_mul(two)} | ${max.saturating_add(one)} ${zero.saturating_sub(one)} ${max.saturating_mul(two)} | ${max.checked_add(one)} ${zero.checked_sub(one)} ${max.checked_mul(two)} | ${one.checked_add(one)} ${two.checked_sub(one)} ${two.checked_mul(two)}`)
}

