package exec_13_08_static_interface_dictionary_capture

import exec_13_08_static_interface_dictionary_capture.iface_defs.{Renderable}
import exec_13_08_static_interface_dictionary_capture.factory.{make_renderable}

## Semantics: a static-imported factory returns an interface value whose
## dictionary was captured where the private implementation was in scope.

fn main() -> void {
  renderable: Renderable = make_renderable("Ada")
  print(renderable.render())
}
