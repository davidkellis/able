    },
    {
      "id": "environment-control-values",
      "kind": "concrete-runtime-boundary",
      "material_families": ["concurrency"],
      "disposition": "single-family-and-causally-closed",
      "reason": "Goroutine identity discovery dominates concurrency, but the generic execution-context ABI regressed Event Routing, Mutex Ledger, and serial guards."
    },
    {
      "id": "allocation-gc",
      "kind": "aggregate-parent",
      "material_families": ["text-map", "wide-numeric", "regex-dispatch", "concurrency"],
      "disposition": "observational-split-owners",
      "reason": "Allocation amplification is broad, but exact owners split among map/text conversion, escaping nominal results, regex state, and concurrency state."
    },
    {
      "id": "direct-generated-application-bodies",
      "kind": "aggregate-parent",
      "material_families": ["text-map", "wide-numeric", "float-numeric", "regex-dispatch", "concurrency"],
      "disposition": "not-one-mechanism",
      "reason": "Generated bodies are broad only as an ancestry label; their concrete work is source-equivalent arithmetic, hashing, regex execution, or concurrency behavior."
    },
    {
      "id": "host-library-boundaries",
      "kind": "semantic-boundary",
      "material_families": ["byte-transformation", "arbitrary-width-integer"],
      "disposition": "different-required-kernels",
