#!/usr/bin/env bash
set -euo pipefail

# Measure locally installed Python and Ruby reference implementations in the
# same verifier-backed, pinned process lane used for Able external benchmarks.
# Missing source/verifier rows are explicit status evidence, not silent skips.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
source "$SCRIPT_DIR/bench_external_catalog.sh"

bench_repo="$REPO_ROOT/../benchmarks"
suite_name="generality"
benchmarks_csv="$(bench_external_suite_csv "$suite_name")"
benchmarks_override=false
languages_csv="python,ruby"
runs=5
timeout_seconds=45
cpu_affinity="${ABLE_BENCH_CPU_AFFINITY:-}"
python_bin="python3"
ruby_bin="ruby"
python_variant="python-3.14"
ruby_variant="ruby-4.0"
output_json=""
output_md=""
workdir=""
keep_tmp=false
require_quiet_cpu=false

usage() {
  cat <<'EOF'
Usage: v12/bench_refresh_interpreter_refs [options]

Runs the available sibling Python and Ruby implementations from their source
directories. Each successful output is checked with the benchmark's verify.rb.
Rows without the requested reference source or verifier are reported as
unavailable status rows and are not timed.

After a timed process expires, that row stops instead of consuming the same
guard repeatedly; the report distinguishes requested from attempted runs.

Options:
      --benchmark-repo DIR  External benchmarks repository (default: ../benchmarks)
      --suite NAME          Catalog suite (default: generality)
  -b, --benchmarks CSV      Benchmark names (overrides --suite)
  -l, --languages CSV       Reference families: python,ruby (default: python,ruby)
  -r, --runs N              Timed processes per available row (default: 5)
  -t, --timeout SEC         Timeout per process (default: 45)
      --cpu-affinity CPUSET CPU pool from which each benchmark's catalog CPU
                            budget is resolved (default: current allowed CPUs)
      --require-quiet-cpu  Require the first resolved serial CPU to pass the
                           host preflight before creating reference artifacts
      --python-bin PATH     Python executable (default: python3)
      --ruby-bin PATH       Ruby executable (default: ruby)
      --python-variant DIR  Source directory beneath a suite (default: python-3.14)
      --ruby-variant DIR    Source directory beneath a suite (default: ruby-4.0)
      --output-json PATH    Write a report with individual verifier-backed run samples
      --output-md PATH      Write Markdown report
      --workdir DIR         Keep stdout/stderr captures in DIR
      --keep                Keep the generated temporary workdir
  -h, --help                Show this help
EOF
}

die() {
  echo "bench_refresh_interpreter_refs: $*" >&2
  exit 1
}

is_int() {
  [[ "$1" =~ ^[0-9]+$ ]]
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --benchmark-repo)
      shift
      [[ $# -gt 0 ]] || die "missing value for --benchmark-repo"
      bench_repo="$1"
      ;;
    --suite)
      shift
      [[ $# -gt 0 ]] || die "missing value for --suite"
      suite_name="$1"
      ;;
    -b|--benchmarks)
      shift
      [[ $# -gt 0 ]] || die "missing value for --benchmarks"
      benchmarks_csv="$1"
      benchmarks_override=true
      ;;
    -l|--languages)
      shift
      [[ $# -gt 0 ]] || die "missing value for --languages"
      languages_csv="$1"
      ;;
    -r|--runs)
      shift
      [[ $# -gt 0 ]] || die "missing value for --runs"
      runs="$1"
      ;;
    -t|--timeout)
      shift
      [[ $# -gt 0 ]] || die "missing value for --timeout"
      timeout_seconds="$1"
      ;;
    --cpu-affinity)
      shift
      [[ $# -gt 0 ]] || die "missing value for --cpu-affinity"
      cpu_affinity="$1"
      ;;
    --cpu-affinity=*)
      cpu_affinity="${1#*=}"
      ;;
    --require-quiet-cpu)
      require_quiet_cpu=true
      ;;
    --python-bin)
      shift
      [[ $# -gt 0 ]] || die "missing value for --python-bin"
      python_bin="$1"
      ;;
    --ruby-bin)
      shift
      [[ $# -gt 0 ]] || die "missing value for --ruby-bin"
      ruby_bin="$1"
      ;;
    --python-variant)
      shift
      [[ $# -gt 0 ]] || die "missing value for --python-variant"
      python_variant="$1"
      ;;
    --ruby-variant)
      shift
      [[ $# -gt 0 ]] || die "missing value for --ruby-variant"
      ruby_variant="$1"
      ;;
    --output-json)
      shift
      [[ $# -gt 0 ]] || die "missing value for --output-json"
      output_json="$1"
      ;;
    --output-md)
      shift
      [[ $# -gt 0 ]] || die "missing value for --output-md"
      output_md="$1"
      ;;
    --workdir)
      shift
      [[ $# -gt 0 ]] || die "missing value for --workdir"
      workdir="$1"
      ;;
    --keep)
      keep_tmp=true
      ;;
    -*)
      die "unknown option: $1"
      ;;
    *)
      die "unexpected positional argument: $1"
      ;;
  esac
  shift
done

is_int "$runs" && ((runs > 0)) || die "--runs must be a positive integer"
is_int "$timeout_seconds" && ((timeout_seconds > 0)) || die "--timeout must be a positive integer"

if [[ "$benchmarks_override" == false ]]; then
  benchmarks_csv="$(bench_external_suite_csv "$suite_name")" || die "unknown suite: $suite_name"
else
  suite_name="custom"
fi

bench_repo="$(realpath "$bench_repo")"
[[ -d "$bench_repo" ]] || die "benchmark repository not found: $bench_repo"
command -v ruby >/dev/null 2>&1 || die "ruby is required for suite verification"

IFS=',' read -r -a languages <<< "$languages_csv"
(( ${#languages[@]} > 0 )) || die "--languages must not be empty"
for language in "${languages[@]}"; do
  case "$language" in
    python|ruby)
      ;;
    *)
      die "unknown reference language: $language"
      ;;
  esac
done

for language in "${languages[@]}"; do
  case "$language" in
    python)
      python_bin="$(command -v "$python_bin")" || die "Python executable not found"
      ;;
    ruby)
      ruby_bin="$(command -v "$ruby_bin")" || die "Ruby executable not found"
      ;;
  esac
done

command -v taskset >/dev/null 2>&1 || die "taskset is required for benchmark CPU contracts"
cpu_pool="$(bench_external_effective_cpu_pool "$cpu_affinity")" || die "cannot resolve benchmark CPU pool"
taskset -c "$cpu_pool" true >/dev/null 2>&1 || die "invalid CPU pool: $cpu_pool"
if [[ "$require_quiet_cpu" == true ]]; then
  quiet_cpu="$(bench_external_resolve_cpu_affinity "$cpu_pool" 1)" || die "cannot resolve quiet-check CPU"
  "$SCRIPT_DIR/bench_host_cpu_check" --cpu "$quiet_cpu"
fi

mkdir -p "$SCRIPT_DIR/tmp"
if [[ -z "$workdir" ]]; then
  workdir="$(mktemp -d "$SCRIPT_DIR/tmp/interpreter-reference-refresh.XXXXXX")"
else
  workdir="$(realpath -m "$workdir")"
  mkdir -p "$workdir"
fi
if [[ "$keep_tmp" == false ]]; then
  trap 'rm -rf "$workdir"' EXIT
fi

if [[ -n "$output_json" ]]; then
  output_json="$(realpath -m "$output_json")"
  mkdir -p "$(dirname "$output_json")"
fi
if [[ -n "$output_md" ]]; then
  output_md="$(realpath -m "$output_md")"
  mkdir -p "$(dirname "$output_md")"
fi

python_version=""
ruby_version=""
for language in "${languages[@]}"; do
  case "$language" in
    python) python_version="$($python_bin --version 2>&1 | head -n 1)" ;;
    ruby) ruby_version="$($ruby_bin --version 2>&1 | head -n 1)" ;;
  esac
done

rows_file="$workdir/rows.tsv"
samples_file="$workdir/samples.tsv"
: > "$rows_file"
: > "$samples_file"
IFS=',' read -r -a benchmarks <<< "$benchmarks_csv"

program_args_for_benchmark() {
  local benchmark="$1"
  local argument
  while IFS= read -r argument; do
    [[ -n "$argument" ]] || continue
    printf '%s\0' "$argument"
  done < <(bench_external_program_args "$benchmark" bytecode)
}

record_row() {
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$@" >> "$rows_file"
}

record_sample() {
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$@" >> "$samples_file"
}

printf '%-20s %-9s %-10s %-10s %-10s %-12s\n' \
  "benchmark" "language" "ok/runs" "timeout" "failure" "real_avg(s)"

for benchmark in "${benchmarks[@]}"; do
  [[ -n "$benchmark" ]] || continue
  suite_dir="$(bench_external_suite_dir "$bench_repo" "$benchmark")"
  [[ -d "$suite_dir" ]] || die "benchmark suite not found for $benchmark: $suite_dir"
  run_dir="$(bench_external_run_dir "$bench_repo" "$benchmark")"
  [[ -d "$run_dir" ]] || die "benchmark run directory not found for $benchmark: $run_dir"
  verify_script="$suite_dir/verify.rb"
  logical_cpu_budget="$(bench_external_logical_cpu_budget "$benchmark" bytecode)" || die "missing bytecode CPU budget for $benchmark"
  resolved_affinity="$(bench_external_resolve_cpu_affinity "$cpu_pool" "$logical_cpu_budget")" || \
    die "CPU pool $cpu_pool cannot satisfy $benchmark bytecode budget $logical_cpu_budget"
  executor_policy="$(bench_external_executor_policy "$benchmark")"
  launch_prefix=(taskset -c "$resolved_affinity")

  if [[ -f "$suite_dir/setup.rb" ]]; then
    ruby "$suite_dir/setup.rb" >/dev/null
  fi

  program_args=()
  while IFS= read -r -d '' argument; do
    program_args+=("$argument")
  done < <(program_args_for_benchmark "$benchmark")

  for language in "${languages[@]}"; do
    case "$language" in
      python)
        implementation="$python_variant"
        source_path="$suite_dir/$python_variant/run.py"
        interpreter=("$python_bin")
        ;;
      ruby)
        implementation="$ruby_variant"
        source_path="$suite_dir/$ruby_variant/run.rb"
        interpreter=("$ruby_bin")
        ;;
    esac

    source_sha256="n/a"
    if [[ -f "$source_path" ]]; then
      source_sha256="$(sha256sum "$source_path" | awk '{print $1}')"
    fi

    if [[ ! -f "$source_path" ]]; then
      printf '%-20s %-9s %-10s %-10s %-10s %-12s\n' \
        "$benchmark" "$language" "0/$runs" "0" "0" "n/a"
      record_row "$benchmark" "$language" "$implementation" "n/a" "$runs" "0" "0" "0" "0" "n/a" "unavailable-source" "n/a" "n/a" \
        "$logical_cpu_budget" "$resolved_affinity" "$executor_policy"
      continue
    fi
    if [[ ! -f "$verify_script" ]]; then
      printf '%-20s %-9s %-10s %-10s %-10s %-12s\n' \
        "$benchmark" "$language" "0/$runs" "0" "0" "n/a"
      record_row "$benchmark" "$language" "$implementation" "$source_path" "$runs" "0" "0" "0" "0" "n/a" "unavailable-verifier" "n/a" "$source_sha256" \
        "$logical_cpu_budget" "$resolved_affinity" "$executor_policy"
      continue
    fi

    benchmark_dir="$workdir/$benchmark/$language"
    mkdir -p "$benchmark_dir"
    ok=0
    attempted=0
    timed_out=0
    failed=0
    verification_failed=0
    total_ns=0
    stdout_hashes=()
    for ((run_index = 1; run_index <= runs; run_index++)); do
      attempted=$((attempted + 1))
      stdout_path="$benchmark_dir/run-${run_index}.stdout"
      stderr_path="$benchmark_dir/run-${run_index}.stderr"
      start_ns="$(date +%s%N)"
      set +e
      (
        cd "$run_dir"
        env "${launch_prefix[@]}" timeout --signal=INT --kill-after=5 "$timeout_seconds" \
          "${interpreter[@]}" "$source_path" "${program_args[@]}"
      ) >"$stdout_path" 2>"$stderr_path"
      run_status=$?
      set -e
      end_ns="$(date +%s%N)"
      duration_ns=$((end_ns - start_ns))

      if [[ "$run_status" -eq 124 || "$run_status" -eq 137 || "$run_status" -eq 143 ]]; then
        timed_out=$((timed_out + 1))
        record_sample "$benchmark" "$language" "$run_index" "timeout" "n/a" "n/a"
        break
      fi
      if [[ "$run_status" -ne 0 ]]; then
        failed=$((failed + 1))
        record_sample "$benchmark" "$language" "$run_index" "error" "n/a" "n/a"
        continue
      fi
      if ! ruby "$verify_script" < "$stdout_path"; then
        verification_failed=$((verification_failed + 1))
        failed=$((failed + 1))
        record_sample "$benchmark" "$language" "$run_index" "verification_failed" "$duration_ns" "$(sha256sum "$stdout_path" | awk '{print $1}')"
        continue
      fi

      total_ns=$((total_ns + duration_ns))
      ok=$((ok + 1))
      stdout_hash="$(sha256sum "$stdout_path" | awk '{print $1}')"
      stdout_hashes+=("$stdout_hash")
      record_sample "$benchmark" "$language" "$run_index" "ok" "$duration_ns" "$stdout_hash"
    done

    unique_hashes="$(printf '%s\n' "${stdout_hashes[@]}" | sed '/^$/d' | sort -u | paste -sd, -)"
    validation="verified"
    if ((verification_failed > 0)); then
      validation="failed"
    elif ((ok > 1)) && [[ "$unique_hashes" == *,* ]]; then
      validation="verified-nondeterministic"
    elif ((ok == 0)); then
      validation="unavailable"
    fi
    average_seconds="n/a"
    if ((ok > 0)); then
      average_seconds="$(awk -v total="$total_ns" -v count="$ok" 'BEGIN { printf "%.4f", total / count / 1000000000 }')"
    fi
    printf '%-20s %-9s %d/%-7d %-10d %-10d %-12s\n' \
      "$benchmark" "$language" "$ok" "$runs" "$timed_out" "$failed" "$average_seconds"
    record_row "$benchmark" "$language" "$implementation" "$source_path" "$runs" "$attempted" "$ok" "$timed_out" "$failed" "$average_seconds" "$validation" "$unique_hashes" "$source_sha256" \
      "$logical_cpu_budget" "$resolved_affinity" "$executor_policy"
  done
done

if [[ -n "$output_json" || -n "$output_md" ]]; then
  ruby - "$rows_file" "$samples_file" "$output_json" "$output_md" "$bench_repo" "$suite_name" "$runs" "$timeout_seconds" "$cpu_pool" "$python_bin" "$python_variant" "$python_version" "$ruby_bin" "$ruby_variant" "$ruby_version" <<'RUBY'
require "json"
require "time"

rows_path, samples_path, json_path, md_path, bench_repo, suite, runs, timeout, cpu_pool,
  python_bin, python_variant, python_version, ruby_bin, ruby_variant, ruby_version = ARGV
samples_by_row = Hash.new { |hash, key| hash[key] = [] }
File.readlines(samples_path, chomp: true).reject(&:empty?).each do |line|
  benchmark, language, run, status, duration_ns, stdout_hash = line.split("\t", 6)
  samples_by_row[[benchmark, language]] << {
    "run" => run.to_i,
    "status" => status,
    "real_seconds" => duration_ns == "n/a" ? nil : duration_ns.to_f / 1_000_000_000,
    "stdout_sha256" => stdout_hash == "n/a" ? nil : stdout_hash,
  }
end
rows = File.readlines(rows_path, chomp: true).reject(&:empty?).map do |line|
  benchmark, language, implementation, source, requested_runs, attempted_runs,
    ok, timed_out, failed, average, validation, hashes, source_sha256,
    logical_cpu_budget, resolved_affinity, executor_policy = line.split("\t", 16)
  {
    "benchmark" => benchmark,
    "language_family" => language,
    "implementation" => implementation,
    "source" => source == "n/a" ? nil : source,
    "source_sha256" => source_sha256 == "n/a" ? nil : source_sha256,
    "requested_runs" => requested_runs.to_i,
    "attempted_runs" => attempted_runs.to_i,
    "ok_runs" => ok.to_i,
    "timeouts" => timed_out.to_i,
    "failures" => failed.to_i,
    "avg_real_seconds" => average == "n/a" ? nil : average.to_f,
    "samples" => samples_by_row[[benchmark, language]],
    "validation" => validation,
    "stdout_sha256" => hashes.nil? || hashes.empty? ? [] : hashes.split(","),
    "execution_contract" => {
      "mode" => "bytecode",
      "logical_cpu_budget" => logical_cpu_budget.to_i,
      "cpu_affinity" => resolved_affinity,
      "executor_policy" => executor_policy,
    },
  }
end
report = {
  "generated_at" => Time.now.utc.iso8601,
  "benchmark_repo" => bench_repo,
  "suite" => suite,
  "runs" => runs.to_i,
  "timeout_seconds" => timeout.to_i,
  "cpu_affinity" => cpu_pool,
  "cpu_affinity_pool" => cpu_pool,
  "runtimes" => {
    "python" => {"executable" => python_bin, "variant" => python_variant, "version" => python_version},
    "ruby" => {"executable" => ruby_bin, "variant" => ruby_variant, "version" => ruby_version},
  },
  "rows" => rows,
}
File.write(json_path, JSON.pretty_generate(report) + "\n") unless json_path.empty?
unless md_path.empty?
  lines = [
    "# Pinned Python/Ruby Reference Refresh",
    "",
    "- Generated: `#{report.fetch("generated_at")}`",
    "- Suite: `#{suite}`",
    "- Python: `#{python_version}` from `#{python_variant}`",
    "- Ruby: `#{ruby_version}` from `#{ruby_variant}`",
    "- Runs: `#{runs}`",
    "- Timeout: `#{timeout}s`",
    "- CPU pool: `#{cpu_pool}` (each row records its resolved catalog budget)",
    "",
    "| Benchmark | Language | Status | Validation | Real (s) | Source SHA-256 | Stdout SHA-256 |",
    "| --- | --- | --- | --- | ---: | --- | --- |",
  ]
  rows.each do |row|
    status = "#{row.fetch("ok_runs")}/#{row.fetch("requested_runs")}" \
      " (attempted #{row.fetch("attempted_runs")}, timeouts #{row.fetch("timeouts")}, failures #{row.fetch("failures")})"
    average = row.fetch("avg_real_seconds")&.then { |value| format("%.4f", value) } || "n/a"
    lines << "| `#{row.fetch("benchmark")}` | #{row.fetch("language_family")} | #{status} | #{row.fetch("validation")} | #{average} | #{row.fetch("source_sha256") || "n/a"} | #{row.fetch("stdout_sha256").join(",")} |"
  end
  File.write(md_path, lines.join("\n") + "\n")
end
RUBY
fi

[[ -z "$output_json" ]] || echo ">>> Wrote interpreter reference JSON: $output_json"
[[ -z "$output_md" ]] || echo ">>> Wrote interpreter reference Markdown: $output_md"
