    for row in report["known_region_budget"]:
        required = row["required_compiled_equivalent_fraction_to_target"]
        required_text = "—" if required is None else f"{required * 100.0:.2f}%"
        lines.append(
            f"| `{row['benchmark']}` | {row['family']} | "
