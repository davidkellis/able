def write_or_check(path: Path, content: str, check: bool, label: str) -> None:
    if check:
        try:
            existing = path.read_text(encoding="utf-8")
        except FileNotFoundError:
            raise SystemExit(f"checked {label} is missing: {path}") from None
        if existing != content:
            raise SystemExit(f"checked {label} is stale: {path}")
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8")


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--json-out", type=Path, default=DEFAULT_JSON)
    parser.add_argument("--markdown-out", type=Path, default=DEFAULT_MARKDOWN)
    parser.add_argument("--check", action="store_true")
    args = parser.parse_args()
    try:
        report = build_report()
    except (OSError, ValueError, json.JSONDecodeError) as error:
        raise SystemExit(str(error)) from None
    json_text = json.dumps(report, indent=2, sort_keys=True) + "\n"
    markdown_text = markdown(report)
    write_or_check(args.json_out, json_text, args.check, "reconciliation JSON")
    write_or_check(args.markdown_out, markdown_text, args.check, "reconciliation Markdown")
    print(report["decision"])


if __name__ == "__main__":
    main()
