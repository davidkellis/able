#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
source "$SCRIPT_DIR/bench_external_catalog.sh"

bench_repo="$REPO_ROOT/../benchmarks"
external_results_json=""
reference_json=""
go_reference_json=""
suite_name="$(bench_external_default_suite)"
benchmarks_csv="$(bench_external_suite_csv "$suite_name")"
modes_csv="compiled,bytecode,treewalker"
languages_csv="go,ruby,python"
runs=5
timeout_seconds=90
build_timeout_seconds=""
bytecode_runtime_calls=1
cpu_affinity="${ABLE_BENCH_CPU_AFFINITY:-}"
output_json=""
output_md=""
keep_tmp=false
workdir=""
benchmarks_override=false
experimental_execution_context=false
require_quiet_cpu=false
compiled_build_args=()

usage() {
  cat <<'EOF'
Usage:
  v12/bench_compare_external [options]

Examples:
  v12/bench_compare_external
  v12/bench_compare_external --benchmarks fib,binarytrees --modes compiled
  v12/bench_compare_external --suite generality --modes bytecode
  v12/bench_compare_external --suite core --modes compiled --experimental-execution-context
  v12/bench_compare_external --output-md /tmp/able-vs-external.md

Options:
      --benchmark-repo DIR  External benchmarks repo (default: ../benchmarks)
      --results-json PATH   External results.json (default: <benchmark-repo>/results.json)
      --reference-json PATH Fresh v12/bench_refresh_interpreter_refs JSON;
                            replaces stored Python/Ruby reference rows
      --go-reference-json PATH
                            Fresh v12/bench_refresh_go_refs JSON; replaces
                            stored Go reference rows
      --suite NAME          Benchmark suite preset: core,full,generality,
                            coverage,numeric-structural,fixed-width,nominal-numeric,wide-integer-records,
                            word-frequency,document-audit,lexical-rollup,
                            channel-rollup,future-pipeline,future-await-race,
                            await-channel-mux,mutex-ledger,mutex-await-journal,mutex-work-queue,concurrency,text-bytes,bulk-output,regex-text,regex-stream,log-routing-redaction,config-validation-extraction,unicode-scalars,
                            array-slice-window,dependency-plan,option-result-config,sudoku-masks,
                            concurrent-signal-dispatch,concurrent-transform-chain,
                            concurrent-policy-callbacks,concurrent-graph-visitors,concurrent-audio-voices,concurrent-packet-codecs,concurrent-scene-tiles,concurrent-tree-folds,concurrent-state-machines,
                            concurrent-stateful-pipeline
      --list-suites         Print available suite names and benchmark members
  -b, --benchmarks CSV      Benchmarks to compare
  -m, --modes CSV           Modes: compiled,bytecode,bytecode-prechecked,
                            treewalker,bytecode-runtime
                            (default: compiled,bytecode,treewalker)
  -l, --languages CSV       External language families to report (default: go,ruby,python)
  -r, --runs N              Runs per Able benchmark/mode (default: 5)
  -t, --timeout SEC         Timeout per Able run in seconds (default: 90)
      --build-timeout SEC   Timeout for CLI/program preparation only
                            (default: the per-run timeout; 0 disables it)
      --bytecode-runtime-calls N
                            Steady-state main() calls per bytecode-runtime
                            benchmark run (default: 1)
      --cpu-affinity CPUSET CPU pool from which each benchmark/mode's catalog
                            CPU budget is resolved (for example 13-16 or
                            2,4,6,8). Defaults to the current allowed CPUs and
                            may also use ABLE_BENCH_CPU_AFFINITY.
      --require-quiet-cpu  Require the first resolved serial CPU to pass the
                           host preflight before creating comparison artifacts.
      --experimental-execution-context
                            Compile with the opt-in generated-call execution-context
                            ABI prototype. This affects Able compiled mode only.
      --compiled-build-arg ARG
                            Extra argument forwarded to compiled preparation.
                            May be repeated (for example --no-fallbacks).
      --output-json PATH    Write machine-readable comparison JSON
      --output-md PATH      Write Markdown report
      --workdir DIR         Keep temporary artifacts in DIR
      --keep                Keep temporary workdir
  -h, --help                Show this help

Notes:
  - This harness builds on v12/bench_perf and compares Able runs against the
    checked-in external benchmark results in ../benchmarks/results.json.
  - Benchmarks that require setup.rb in the external repo will run that setup
    automatically before the Able measurement.
  - When a suite provides verify.rb, every successful Able stdout capture is
    verified after timing. Verification failures invalidate that mode's row.
  - The default is five independent verifier-backed runs for workstation
    averaging. Use an explicit lower --runs value only for a smoke check; it
    must not be used to select or validate a performance change.
  - JSON output retains Able and fresh-reference per-run samples when they are
    available, so `bench_variance_report` can analyze one repeated report.
  - Benchmarks with explicitly parallel external reference workloads may also
    set a benchmark-specific executor (for example binarytrees uses the
    goroutine executor).
EOF
}

die() {
  echo "bench_compare_external: $*" >&2
  exit 1
}

is_int() {
  [[ "$1" =~ ^[0-9]+$ ]]
}

list_suites() {
  local suite
  for suite in $(bench_external_suite_names); do
    printf '%s\t%s\n' "$suite" "$(bench_external_suite_csv "$suite")"
  done
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --benchmark-repo)
      shift
      [[ $# -gt 0 ]] || die "missing value for --benchmark-repo"
      bench_repo="$1"
      ;;
    --results-json)
      shift
      [[ $# -gt 0 ]] || die "missing value for --results-json"
      external_results_json="$1"
      ;;
    --reference-json)
      shift
      [[ $# -gt 0 ]] || die "missing value for --reference-json"
      reference_json="$1"
      ;;
    --go-reference-json)
      shift
      [[ $# -gt 0 ]] || die "missing value for --go-reference-json"
      go_reference_json="$1"
      ;;
    --suite)
      shift
      [[ $# -gt 0 ]] || die "missing value for --suite"
      suite_name="$1"
      ;;
    --list-suites)
      list_suites
      exit 0
      ;;
    -b|--benchmarks)
      shift
      [[ $# -gt 0 ]] || die "missing value for --benchmarks"
      benchmarks_csv="$1"
      benchmarks_override=true
      ;;
    -m|--modes)
      shift
      [[ $# -gt 0 ]] || die "missing value for --modes"
      modes_csv="$1"
      ;;
    -l|--languages)
      shift
      [[ $# -gt 0 ]] || die "missing value for --languages"
      languages_csv="$1"
      ;;
    -r|--runs)
      shift
      [[ $# -gt 0 ]] || die "missing value for --runs"
      runs="$1"
      ;;
    -t|--timeout)
      shift
      [[ $# -gt 0 ]] || die "missing value for --timeout"
      timeout_seconds="$1"
      ;;
    --build-timeout)
      shift
      [[ $# -gt 0 ]] || die "missing value for --build-timeout"
      build_timeout_seconds="$1"
      ;;
    --bytecode-runtime-calls)
      shift
      [[ $# -gt 0 ]] || die "missing value for --bytecode-runtime-calls"
      bytecode_runtime_calls="$1"
      ;;
    --bytecode-runtime-calls=*)
      bytecode_runtime_calls="${1#*=}"
      ;;
    --cpu-affinity)
      shift
      [[ $# -gt 0 ]] || die "missing value for --cpu-affinity"
      cpu_affinity="$1"
      ;;
    --cpu-affinity=*)
      cpu_affinity="${1#*=}"
      ;;
    --require-quiet-cpu)
      require_quiet_cpu=true
      ;;
    --experimental-execution-context)
      experimental_execution_context=true
      ;;
    --compiled-build-arg)
      shift
      [[ $# -gt 0 ]] || die "missing value for --compiled-build-arg"
      compiled_build_args+=("$1")
      ;;
    --compiled-build-arg=*)
      compiled_build_args+=("${1#*=}")
      ;;
    --output-json)
      shift
      [[ $# -gt 0 ]] || die "missing value for --output-json"
      output_json="$1"
      ;;
    --output-md)
      shift
      [[ $# -gt 0 ]] || die "missing value for --output-md"
      output_md="$1"
      ;;
    --workdir)
      shift
      [[ $# -gt 0 ]] || die "missing value for --workdir"
      workdir="$1"
      ;;
    --keep)
      keep_tmp=true
      ;;
    -*)
      die "unknown option: $1"
      ;;
    *)
      die "unexpected positional argument: $1"
      ;;
  esac
  shift
done

is_int "$runs" && ((runs > 0)) || die "--runs must be a positive integer"
is_int "$timeout_seconds" && ((timeout_seconds > 0)) || die "--timeout must be a positive integer"
if [[ -n "$build_timeout_seconds" ]]; then
  is_int "$build_timeout_seconds" || die "--build-timeout must be a non-negative integer"
fi
is_int "$bytecode_runtime_calls" && ((bytecode_runtime_calls > 0)) || die "--bytecode-runtime-calls must be a positive integer"

if [[ "$benchmarks_override" == false ]]; then
  benchmarks_csv="$(bench_external_suite_csv "$suite_name")" || die "unknown suite: $suite_name"
else
  suite_name="custom"
fi

bench_repo="$(realpath "$bench_repo")"
[[ -d "$bench_repo" ]] || die "benchmark repo not found: $bench_repo"

if [[ -z "$external_results_json" ]]; then
  external_results_json="$bench_repo/results.json"
fi
external_results_json="$(realpath "$external_results_json")"
[[ -f "$external_results_json" ]] || die "results.json not found: $external_results_json"
if [[ -n "$reference_json" ]]; then
  reference_json="$(realpath "$reference_json")"
  [[ -f "$reference_json" ]] || die "reference JSON not found: $reference_json"
fi
if [[ -n "$go_reference_json" ]]; then
  go_reference_json="$(realpath "$go_reference_json")"
  [[ -f "$go_reference_json" ]] || die "Go reference JSON not found: $go_reference_json"
fi

command -v taskset >/dev/null 2>&1 || die "taskset is required for benchmark CPU contracts"
cpu_pool="$(bench_external_effective_cpu_pool "$cpu_affinity")" || die "cannot resolve benchmark CPU pool"
taskset -c "$cpu_pool" true >/dev/null 2>&1 || die "invalid CPU pool: $cpu_pool"
if [[ "$require_quiet_cpu" == true ]]; then
  quiet_cpu="$(bench_external_resolve_cpu_affinity "$cpu_pool" 1)" || die "cannot resolve quiet-check CPU"
  "$SCRIPT_DIR/bench_host_cpu_check" --cpu "$quiet_cpu"
fi

bench_execution_context_args=()
if [[ "$experimental_execution_context" == true ]]; then
  bench_execution_context_args=(--experimental-execution-context)
fi
bench_build_timeout_args=()
if [[ -n "$build_timeout_seconds" ]]; then
  bench_build_timeout_args=(--build-timeout "$build_timeout_seconds")
fi

mkdir -p "$SCRIPT_DIR/tmp"
if [[ -z "$workdir" ]]; then
  workdir="$(mktemp -d "$SCRIPT_DIR/tmp/external-compare.XXXXXX")"
else
  workdir="$(realpath -m "$workdir")"
  mkdir -p "$workdir"
fi

if [[ "$keep_tmp" == false ]]; then
  trap 'rm -rf "$workdir"' EXIT
fi

if [[ -n "$output_json" ]]; then
  output_json="$(realpath -m "$output_json")"
  mkdir -p "$(dirname "$output_json")"
fi
if [[ -n "$output_md" ]]; then
  output_md="$(realpath -m "$output_md")"
  mkdir -p "$(dirname "$output_md")"
fi

summary_rows="$workdir/rows.tsv"
: > "$summary_rows"
benchmark_contract_rows="$workdir/benchmark-contracts.jsonl"
: > "$benchmark_contract_rows"

IFS=',' read -r -a requested_benchmarks <<<"$benchmarks_csv"
IFS=',' read -r -a requested_modes <<<"$modes_csv"
for mode in "${requested_modes[@]}"; do
  case "$mode" in
    ""|compiled|bytecode|bytecode-prechecked|treewalker|bytecode-runtime)
      ;;
    *)
      die "unknown mode: $mode"
      ;;
  esac
done

echo ">>> External benchmark repo: $bench_repo"
echo ">>> External results: $external_results_json"
if [[ -n "$reference_json" ]]; then
  echo ">>> Fresh Python/Ruby references: $reference_json"
fi
if [[ -n "$go_reference_json" ]]; then
  echo ">>> Fresh Go references: $go_reference_json"
fi
echo ">>> Suite: $suite_name"
echo ">>> Workdir: $workdir"
echo ">>> CPU pool: $cpu_pool"
if [[ "$experimental_execution_context" == true ]]; then
  echo ">>> Experimental execution context: enabled for compiled mode"
fi

for bench in "${requested_benchmarks[@]}"; do
  [[ -n "$bench" ]] || continue

  suite_dir="$(bench_external_suite_dir "$bench_repo" "$bench")"
  [[ -d "$suite_dir" ]] || die "benchmark suite directory not found for $bench: $suite_dir"

  if [[ -f "$suite_dir/setup.rb" ]]; then
    echo ">>> Running external setup for $bench"
    (cd "$suite_dir" && ruby setup.rb >/dev/null)
  fi

  target="$(bench_external_target "$SCRIPT_DIR" "$bench")" || die "no Able target mapping for benchmark: $bench"
  target="$(realpath "$target")"
  [[ -f "$target" ]] || die "Able target not found for $bench: $target"
  target_sha256="$(sha256sum "$target" | awk '{print $1}')"

  bench_run_from="$(bench_external_run_dir "$bench_repo" "$bench")"
  [[ -d "$bench_run_from" ]] || die "benchmark run directory not found for $bench: $bench_run_from"

  bench_executor="$(bench_external_executor "$bench" || true)"
  bench_executor_args=()
  if [[ -n "$bench_executor" ]]; then
    bench_executor_args=(--executor "$bench_executor")
  fi

  bench_source_root_args=()
  if bench_external_source_root_only "$bench"; then
    bench_source_root_args=(--source-root-only)
  fi

  bench_verifier_args=()
  if [[ -f "$suite_dir/verify.rb" ]]; then
    bench_verifier_args=(--verify-ruby-script "$suite_dir/verify.rb")
    echo ">>> Verifying successful Able output for $bench"
  else
    echo ">>> No output verifier for $bench"
  fi

  for mode in "${requested_modes[@]}"; do
    [[ -n "$mode" ]] || continue
    bench_program_args=()
    while IFS= read -r arg; do
      [[ -n "$arg" ]] || continue
      bench_program_args+=("$arg")
    done < <(bench_external_program_args "$bench" "$mode")

    # Capture the verifier and explicitly declared file arguments for this
    # benchmark/mode before launching the timed processes. Workload scale is a
    # comparison contract, so compiled and interpreter rows may deliberately
    # name different arguments while retaining the same program and verifier.
    python - "$benchmark_contract_rows" "$bench" "$mode" "$bench_run_from" "$suite_dir/verify.rb" "${bench_program_args[@]}" <<'PY'
import hashlib
import json
import sys
from pathlib import Path

output_path, benchmark, mode, raw_run_dir, raw_verifier, *program_args = sys.argv[1:]
run_dir = Path(raw_run_dir).resolve()
verifier = Path(raw_verifier).resolve()

def fingerprint(path):
    return {
        "path": str(path),
        "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
    }

input_files = []
for argument in program_args:
    candidate = Path(argument)
    if not candidate.is_absolute():
        candidate = run_dir / candidate
    candidate = candidate.resolve()
    if candidate.is_file():
        input_files.append({"argument": argument, **fingerprint(candidate)})

contract = {
    "program_args": program_args,
    "verifier": fingerprint(verifier) if verifier.is_file() else None,
    "input_files": input_files,
}
contract["sha256"] = hashlib.sha256(
    json.dumps(contract, sort_keys=True, separators=(",", ":")).encode("utf-8")
).hexdigest()
contract["provenance"] = "measured"
with open(output_path, "a", encoding="utf-8") as out:
    out.write(
        json.dumps(
            {"benchmark": benchmark, "mode": mode, "contract": contract},
            sort_keys=True,
        )
        + "\n"
    )
PY

    logical_cpu_budget="$(bench_external_logical_cpu_budget "$bench" "$mode")" || \
      die "missing CPU budget for $bench/$mode"
    resolved_affinity="$(bench_external_resolve_cpu_affinity "$cpu_pool" "$logical_cpu_budget")" || \
      die "CPU pool $cpu_pool cannot satisfy $bench/$mode budget $logical_cpu_budget"
    executor_policy="$(bench_external_executor_policy "$bench")"
    bench_json="$workdir/${bench}-${mode}.json"
    bench_compiled_build_args=()
    if [[ "$mode" == "compiled" ]]; then
      for compiled_build_arg in "${compiled_build_args[@]}"; do
        bench_compiled_build_args+=("--compiled-build-arg=$compiled_build_arg")
      done
    fi
    bench_artifact_args=()
    if [[ "$keep_tmp" == true ]]; then
      bench_artifact_args=(--workdir "$workdir/artifacts/$bench-$mode" --keep)
    fi
    echo ">>> Benchmark: $bench/$mode (CPUs $resolved_affinity; $executor_policy executor policy)"
    set +e
    env GOMAXPROCS="$logical_cpu_budget" "$SCRIPT_DIR/bench_perf" \
      --runs "$runs" \
      --timeout "$timeout_seconds" \
      "${bench_build_timeout_args[@]}" \
      --bytecode-runtime-calls "$bytecode_runtime_calls" \
      --modes "$mode" \
      --run-from "$bench_run_from" \
      --output-json "$bench_json" \
      --cpu-affinity "$resolved_affinity" \
      "${bench_execution_context_args[@]}" \
      "${bench_compiled_build_args[@]}" \
      "${bench_artifact_args[@]}" \
      "${bench_executor_args[@]}" \
      "${bench_source_root_args[@]}" \
      "${bench_verifier_args[@]}" \
      "${bench_program_args[@]/#/--program-arg=}" \
      "$target"
    bench_perf_rc=$?
    set -e

    if [[ "$bench_perf_rc" -ne 0 ]]; then
      echo ">>> Benchmark failed before summary for $bench/$mode (exit $bench_perf_rc); recording failure row"
      python - "$bench" "$mode" "$summary_rows" "$target" "$target_sha256" "$logical_cpu_budget" "$resolved_affinity" "$executor_policy" <<'PY'
import sys

bench, mode, rows_path, source_path, source_sha256, logical_cpu_budget, cpu_affinity, executor_policy = sys.argv[1:]
with open(rows_path, "a", encoding="utf-8") as out:
    out.write(
        "\t".join([
            bench, mode, "0", "0", "1", "n/a", "n/a", "n/a", "n/a",
            "unavailable", "n/a", "0", "0", "n/a", source_path, source_sha256, "[]",
            logical_cpu_budget, cpu_affinity, executor_policy, "{}",
        ])
        + "\n"
    )
PY
      continue
    fi

    python - "$bench" "$bench_json" "$summary_rows" "$target" "$target_sha256" "$logical_cpu_budget" "$resolved_affinity" "$executor_policy" <<'PY'
import json
import sys

bench, bench_json, rows_path, source_path, source_sha256, logical_cpu_budget, cpu_affinity, executor_policy = sys.argv[1:]
with open(bench_json, "r", encoding="utf-8") as f:
    payload = json.load(f)
with open(rows_path, "a", encoding="utf-8") as out:
    for row in payload.get("results", []):
        validation = row.get("validation", {})
        stdout_hashes = validation.get("stdout_sha256", [])
        out.write(
            "\t".join(
                [
                    bench,
                    row["mode"],
                    str(row["ok_runs"]),
                    str(row["timeouts"]),
                    str(row["failures"]),
                    "n/a" if row["avg_real_seconds"] is None else f"{row['avg_real_seconds']:.6f}",
                    "n/a" if row["avg_user_seconds"] is None else f"{row['avg_user_seconds']:.6f}",
                    "n/a" if row["avg_sys_seconds"] is None else f"{row['avg_sys_seconds']:.6f}",
                    "n/a" if row["avg_gc"] is None else f"{row['avg_gc']:.2f}",
                    validation.get("status", "unavailable"),
                    validation.get("verifier") or "n/a",
                    str(validation.get("verified_runs", 0)),
                    str(validation.get("failed_runs", 0)),
                    ",".join(stdout_hashes) if stdout_hashes else "n/a",
                    source_path,
                    source_sha256,
                    json.dumps(row.get("samples", []), separators=(",", ":")),
                    logical_cpu_budget,
                    cpu_affinity,
                    executor_policy,
                    json.dumps(payload.get("go_toolchain") or {}, separators=(",", ":")),
                ]
            )
            + "\n"
        )
PY
  done
done

env PYTHONPATH="$SCRIPT_DIR${PYTHONPATH:+:$PYTHONPATH}" python - "$summary_rows" "$benchmark_contract_rows" "$external_results_json" "$reference_json" "$go_reference_json" "$languages_csv" "$benchmarks_csv" "$modes_csv" "$bytecode_runtime_calls" "$output_json" "$output_md" "$cpu_pool" "$suite_name" "$experimental_execution_context" <<'PY'
import json
import hashlib
import math
import sys
from datetime import datetime, timezone
from pathlib import Path
from bench_go_toolchain_contract import require_matching_go_toolchains

rows_path, contracts_path, external_results_path, reference_path, go_reference_path, languages_csv, benchmarks_csv, modes_csv, bytecode_runtime_calls, output_json, output_md, cpu_pool, suite_name, experimental_execution_context = sys.argv[1:]
requested_languages = [x for x in languages_csv.split(",") if x]
requested_benchmarks = [x for x in benchmarks_csv.split(",") if x]
requested_modes = [x for x in modes_csv.split(",") if x]

def is_sha256(value):
    return (
        isinstance(value, str)
        and len(value) == 64
        and all(character in "0123456789abcdef" for character in value)
    )

def fresh_reference_source(row):
    raw_path = row.get("source")
    if not isinstance(raw_path, str) or not raw_path:
        raise ValueError("successful fresh reference row has no source path")
    source_path = Path(raw_path).resolve()
    if not source_path.is_file():
        raise ValueError(f"fresh reference source is missing: {source_path}")
    current_sha256 = hashlib.sha256(source_path.read_bytes()).hexdigest()
    recorded_sha256 = row.get("source_sha256")
    if recorded_sha256 is None:
        return {
            "path": str(source_path),
            "sha256": current_sha256,
            "provenance": "current",
        }
    if not is_sha256(recorded_sha256):
        raise ValueError(f"fresh reference source has invalid SHA-256: {source_path}")
    if recorded_sha256 != current_sha256:
        raise ValueError(
            f"fresh reference source changed since measurement: {source_path}; refresh references"
        )
    return {
        "path": str(source_path),
        "sha256": recorded_sha256,
        "provenance": "measured",
    }

def external_benchmark_name(name: str) -> str:
    return {
        "i_before_e": "i-before-e",
        "k_nucleotide": "k-nucleotide",
        "fixed_width_128": "fixed-width-128",
        "rational_series": "rational-series",
        "wide_integer_records": "wide-integer-records",
        "log_routing_redaction": "log-routing-redaction",
        "config_validation_extraction": "config-validation-extraction",
        "word_frequency": "word-frequency",
        "document_audit": "document-audit",
        "lexical_rollup": "lexical-rollup",
        "reverse_complement": "reverse-complement",
        "tapelang_alphabet": "tapelang-alphabet",
        "mutex_ledger": "mutex-ledger",
        "mutex_await_journal": "mutex-await-journal",
        "mutex_work_queue": "mutex-work-queue",
    }.get(name, name)

rows = []
with open(rows_path, "r", encoding="utf-8") as f:
    for line in f:
        line = line.rstrip("\n")
        if not line:
            continue
        (
            bench, mode, ok, timeouts, failures, avg_real, avg_user, avg_sys, avg_gc,
            validation_status, validation_verifier, validation_verified,
            validation_failed, stdout_hashes, source_path, source_sha256, samples_json,
            logical_cpu_budget, resolved_affinity, executor_policy,
            go_toolchain_json,
        ) = line.split("\t")
        rows.append({
            "benchmark": bench,
            "mode": mode,
            "ok_runs": int(ok),
            "timeouts": int(timeouts),
            "failures": int(failures),
            "avg_real_seconds": None if avg_real == "n/a" else float(avg_real),
            "avg_user_seconds": None if avg_user == "n/a" else float(avg_user),
            "avg_sys_seconds": None if avg_sys == "n/a" else float(avg_sys),
            "avg_gc": None if avg_gc == "n/a" else float(avg_gc),
            "samples": json.loads(samples_json),
            "validation": {
                "status": validation_status,
                "verifier": None if validation_verifier == "n/a" else validation_verifier,
                "verified_runs": int(validation_verified),
                "failed_runs": int(validation_failed),
                "stdout_sha256": [] if stdout_hashes == "n/a" else stdout_hashes.split(","),
            },
            "source": {
                "path": source_path,
                "sha256": source_sha256,
            },
            "execution_contract": {
                "mode": mode,
                "logical_cpu_budget": int(logical_cpu_budget),
                "cpu_affinity": resolved_affinity,
                "executor_policy": executor_policy,
            },
            "go_toolchain": json.loads(go_toolchain_json),
        })

def execution_contract(raw, context):
    if not isinstance(raw, dict):
        raise ValueError(f"{context}: execution_contract must be an object")
    mode = raw.get("mode")
    budget = raw.get("logical_cpu_budget")
    affinity = raw.get("cpu_affinity")
    executor = raw.get("executor_policy")
    if not isinstance(mode, str) or not mode:
        raise ValueError(f"{context}: execution_contract.mode must be a non-empty string")
    if not isinstance(budget, int) or isinstance(budget, bool) or budget <= 0:
        raise ValueError(f"{context}: execution_contract.logical_cpu_budget must be positive")
    if not isinstance(affinity, str) or not affinity:
        raise ValueError(f"{context}: execution_contract.cpu_affinity must be non-empty")
    if executor not in {"serial", "goroutine"}:
        raise ValueError(f"{context}: execution_contract.executor_policy is invalid")
    return {
        "mode": mode,
        "logical_cpu_budget": budget,
        "cpu_affinity": affinity,
        "executor_policy": executor,
    }

def compatible_execution_contracts(able_contract, reference_contract):
    return all(
        able_contract[field] == reference_contract[field]
        for field in ("logical_cpu_budget", "cpu_affinity", "executor_policy")
    )

benchmark_contracts = {}
with open(contracts_path, "r", encoding="utf-8") as f:
