                and row.get("avg_real_seconds") is not None
            ]
            source = "fresh-go"
        elif lang != "go" and reference_path:
            candidates = [
                row for row in fresh_reference_rows
                if row.get("benchmark") == bench
                and row.get("language_family") == lang
                and row.get("validation") in {"verified", "verified-nondeterministic"}
                and row.get("failures", 0) == 0
                and row.get("ok_runs", 0) > 0
                and row.get("avg_real_seconds") is not None
            ]
            source = "fresh-interpreter"
        else:
            external_bench = external_benchmark_name(bench)
            candidates = [
                row for row in external_results
                if row.get("benchmark") == external_bench
                and row.get("status") == "ok"
                and row.get("language_family") == lang
                and row.get("real_time_secs") is not None
            ]
            source = "stored"
        if not candidates:
            continue
        if source == "fresh-go":
            best = min(candidates, key=lambda row: row["avg_real_seconds"])
            bench_refs[lang] = {
                "implementation": fresh_go_implementation,
                "real_time_secs": float(best["avg_real_seconds"]),
                "source": fresh_reference_source(best),
                "samples": best.get("samples", []),
                "execution_contract": execution_contract(
                    best.get("execution_contract"), f"fresh Go reference {bench}"
                ),
                "go_toolchain": fresh_go_toolchain,
            }
        elif source == "fresh-interpreter":
            best = min(candidates, key=lambda row: row["avg_real_seconds"])
            bench_refs[lang] = {
                "implementation": best.get("implementation"),
                "real_time_secs": float(best["avg_real_seconds"]),
                "source": fresh_reference_source(best),
                "samples": best.get("samples", []),
                "execution_contract": execution_contract(
                    best.get("execution_contract"), f"fresh {lang} reference {bench}"
                ),
            }
        else:
            best = min(candidates, key=lambda row: row["real_time_secs"])
            bench_refs[lang] = {
