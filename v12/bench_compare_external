    reference[bench] = bench_refs

report_rows = []
for bench in requested_benchmarks:
    for mode in requested_modes:
        able = next((row for row in rows if row["benchmark"] == bench and row["mode"] == mode), None)
        if able is None:
            continue
        refs = reference.get(bench, {})
        comparisons = {}
        for lang, ref in refs.items():
            if (mode == "compiled") != (lang == "go"):
                continue
            if mode != "compiled" and lang not in {"python", "ruby"}:
                continue
            reference_contract = ref.get("execution_contract")
            if reference_contract is not None and not compatible_execution_contracts(
                able["execution_contract"], reference_contract
            ):
                raise ValueError(
                    f"execution contract mismatch for {bench}/{mode}/{lang}: "
                    f"Able={able['execution_contract']}, reference={reference_contract}"
                )
            if mode == "compiled" and lang == "go" and go_reference_path:
                require_matching_go_toolchains(
                    able.get("go_toolchain"),
                    ref.get("go_toolchain"),
                    context=f"{bench}/{mode}/{lang}",
                )
            ratio = None
            if (
                able["failures"] == 0
                and able["validation"]["status"] != "failed"
                and able["avg_real_seconds"] is not None
                and ref["real_time_secs"] > 0
            ):
                ratio = able["avg_real_seconds"] / ref["real_time_secs"]
            comparisons[lang] = {
                "reference_real_seconds": ref["real_time_secs"],
                "reference_implementation": ref["implementation"],
                "ratio": ratio,
            }
            if "source" in ref:
                comparisons[lang]["reference_source"] = ref["source"]
            if ref.get("samples"):
                comparisons[lang]["reference_samples"] = ref["samples"]
            if reference_contract is not None:
                comparisons[lang]["execution_contract"] = reference_contract
            if ref.get("go_toolchain"):
                comparisons[lang]["reference_toolchain"] = ref["go_toolchain"]
        report_rows.append({
            "benchmark": bench,
            "mode": mode,
            "able": able,
            "execution_contract": able["execution_contract"],
            "benchmark_contract": benchmark_contracts[(bench, mode)],
            "comparisons": comparisons,
