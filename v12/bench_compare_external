        mode = item.get("mode")
        contract = item.get("contract")
        if (
            not isinstance(benchmark, str)
            or not isinstance(mode, str)
            or not isinstance(contract, dict)
        ):
            raise ValueError("invalid benchmark verifier/input contract")
        key = (benchmark, mode)
        if key in benchmark_contracts:
            raise ValueError(
                f"duplicate benchmark verifier/input contract: {benchmark}/{mode}"
            )
        benchmark_contracts[key] = contract
for benchmark in requested_benchmarks:
    for mode in requested_modes:
        if (benchmark, mode) not in benchmark_contracts:
